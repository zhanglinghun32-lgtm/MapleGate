@Logic
script BattleFlowLogic extends Logic

    -- Server-side battle orchestration boundary.
    -- It prepares or receives payloads, starts BattleSystem, and notifies BattleClientLogic by Client RPC.

    property table activeFieldBattlesByUser = {}
    property table activeBattleEntitiesByUser = {}

    @ExecSpace("ServerOnly")
    method boolean StartFieldBattle(Entity playerEntity, Entity targetEntity, string actionKey)
        -- Called only from a confirmed world-field AttackComponent hit.
        if isvalid(playerEntity) == false or isvalid(targetEntity) == false then
            log_warning("[BattleFlowLogic] StartFieldBattle failed: player or target is invalid.")
            return false
        end

        if actionKey ~= "normalAttack" then
            log_warning("[BattleFlowLogic] StartFieldBattle rejected action=" .. tostring(actionKey))
            return false
        end

        local mapEntity = playerEntity.CurrentMap
        if isvalid(mapEntity) == false or targetEntity.CurrentMap ~= mapEntity then
            log_warning("[BattleFlowLogic] StartFieldBattle failed: entities are not on the same map.")
            return false
        end

        local playerComponent = playerEntity.PlayerComponent
        if playerComponent == nil or playerComponent.UserId == nil or playerComponent.UserId == "" then
            log_warning("[BattleFlowLogic] StartFieldBattle failed: player UserId is empty.")
            return false
        end

        local playerUserId = playerComponent.UserId
        if self.activeFieldBattlesByUser[playerUserId] ~= nil then
            log_warning("[BattleFlowLogic] StartFieldBattle ignored: battle already active. userId=" .. playerUserId)
            return false
        end

        local playerActor = playerEntity:GetComponent("script.BattleActorCom")
        local targetActor = targetEntity:GetComponent("script.BattleActorCom")
        if playerActor == nil or targetActor == nil then
            log_warning("[BattleFlowLogic] StartFieldBattle failed: BattleActorCom missing.")
            return false
        end

        local sequence = tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
        local battleId = "Field_" .. playerUserId .. "_" .. sequence
        self.activeFieldBattlesByUser[playerUserId] = battleId

        local battleEntity = _SpawnService:SpawnByModelId(
            "battlesystem",
            "FieldBattleSession_" .. sequence,
            Vector3(0, 0, 0),
            mapEntity
        )
        if isvalid(battleEntity) == false then
            self.activeFieldBattlesByUser[playerUserId] = nil
            log_warning("[BattleFlowLogic] StartFieldBattle failed: BattleSystem spawn returned invalid entity.")
            return false
        end

        local playerPosition = playerEntity.TransformComponent.WorldPosition
        local targetPosition = targetEntity.TransformComponent.WorldPosition
        local playerActorId = "Player_" .. playerUserId
        local targetActorId = targetEntity.Id
        local playerActorEntry = self:BuildFieldActorEntry(playerActorId, _BattleKeys.actorTypePlayer, playerEntity, playerActor, playerPosition)
        playerActorEntry.skillKeys = _SkillLogic:GetLearnedSkillKeys(playerUserId)
        local targetActorEntry = self:BuildFieldActorEntry(targetActorId, _BattleKeys.actorTypeMonster, targetEntity, targetActor, targetPosition)
        targetActorEntry.skillKeys = { "normalAttack" }
        local payload = {
            battleId = battleId,
            sceneKey = "World",
            mapName = mapEntity.Name,
            sponsorEntityId = playerEntity.Id,
            playerUserId = playerUserId,
            encounterKey = targetEntity.Name,
            rewardKey = "",
            battleRuleKey = "FieldEncounter",
            canEscape = true,
            maxTurnCount = 0,
            openingActionKey = actionKey,
            playerParty = {
                playerActorEntry
            },
            enemyParty = {
                targetActorEntry
            }
        }

        log("[BattleFlowLogic] StartFieldBattle hit confirmed. battleId=" .. battleId
            .. ", action=" .. actionKey .. ", target=" .. tostring(targetEntity.Name))
        local started = self:StartBattle(payload, battleEntity)
        if started == false then
            self.activeFieldBattlesByUser[playerUserId] = nil
        end
        return started
    end

    @ExecSpace("ServerOnly")
    method table BuildFieldActorEntry(string actorId, string actorType, Entity entity, any battleActor, Vector3 position)
        return {
            actorId = actorId,
            actorType = actorType,
            entityId = entity.Id,
            configId = battleActor.configId,
            level = battleActor.level,
            hp = battleActor.hp,
            maxHp = battleActor.maxHp,
            mp = battleActor.mp,
            maxMp = battleActor.maxMp,
            stamina = battleActor.stamina,
            maxStamina = battleActor.maxStamina,
            totalAttack = battleActor.totalAttack,
            totalDefense = battleActor.totalDefense,
            speed = battleActor.speed,
            x = position.x,
            y = position.y
        }
    end

    @ExecSpace("ServerOnly")
    method boolean StartBattle(table payload, Entity battleEntity)
        -- Starts a prepared BattleSystem session and then enters battle mode on the owning client.
        if payload == nil then
            log_warning("[BattleFlowLogic] StartBattle failed: payload is nil.")
            return false
        end

        if isvalid(battleEntity) == false then
            log_warning("[BattleFlowLogic] StartBattle failed: battleEntity is invalid.")
            return false
        end

        ---@type BattleSystem
        local battleSystem = battleEntity:GetComponent("script.BattleSystem")
        if battleSystem == nil then
            log_warning("[BattleFlowLogic] StartBattle failed: BattleSystem component missing.")
            return false
        end

        local battleId = _DataUtil:GetTableString(payload, "battleId", "")
        local playerUserId = _DataUtil:GetTableString(payload, "playerUserId", "")

        if battleId == "" then
            log_warning("[BattleFlowLogic] StartBattle failed: battleId is empty.")
            return false
        end

        if playerUserId == "" then
            log_warning("[BattleFlowLogic] StartBattle failed: playerUserId is empty. battleId=" .. battleId)
            return false
        end

        local started = battleSystem:StartBattle(payload)
        if started == false then
            log_warning("[BattleFlowLogic] StartBattle failed inside BattleSystem. battleId=" .. battleId)
            return false
        end

        self.activeBattleEntitiesByUser[playerUserId] = battleEntity

        -- Only notify the client after the server session is valid.
        -- battleEntity crosses RPC so the client can read @Sync fields on BattleSystem.
        self:NotifyBattleEntered(playerUserId, battleId, battleEntity)
        log("[BattleFlowLogic] StartBattle battleId=" .. battleId .. ", userId=" .. playerUserId)
        return true
    end

    @ExecSpace("ServerOnly")
    method void HandleBattleFinished(string playerUserId, string battleId, string result)
        -- Receives battle completion from BattleSystem and exits battle mode on the owning client.
        if playerUserId == nil or playerUserId == "" then
            log_warning("[BattleFlowLogic] HandleBattleFinished ignored: playerUserId is empty. battleId=" .. tostring(battleId))
            return
        end

        if battleId == nil or battleId == "" then
            log_warning("[BattleFlowLogic] HandleBattleFinished ignored: battleId is empty. userId=" .. playerUserId)
            return
        end

        if result == nil or result == "" then
            result = _BattleKeys.resultCancel
        end

        if self.activeFieldBattlesByUser[playerUserId] == battleId then
            self.activeFieldBattlesByUser[playerUserId] = nil
        end
        self.activeBattleEntitiesByUser[playerUserId] = nil

        local playerEntity = _UserService:GetUserEntityByUserId(playerUserId)
        if isvalid(playerEntity) == true then
            local fieldNormalAttack = playerEntity:GetComponent("script.FieldNormalAttack")
            if fieldNormalAttack ~= nil then
                fieldNormalAttack:ResetAfterBattle()
            end
        end

        self:NotifyBattleExited(playerUserId, battleId, result)
        log("[BattleFlowLogic] HandleBattleFinished battleId=" .. battleId .. ", result=" .. result .. ", userId=" .. playerUserId)
    end

    @ExecSpace("ServerOnly")
    method Entity GetActiveBattleEntity(string userId)
        if userId == nil or userId == "" then
            return nil
        end
        local battleEntity = self.activeBattleEntitiesByUser[userId]
        if isvalid(battleEntity) then
            return battleEntity
        end
        self.activeBattleEntitiesByUser[userId] = nil
        return nil
    end

    @ExecSpace("ServerOnly")
    method void NotifyBattleEntered(string playerUserId, string battleId, Entity battleEntity)
        -- Sends the client-only enter-battle presentation command to one user.
        -- UI open is a one-shot Client RPC command — not driven by @Sync.
        if playerUserId == nil or playerUserId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleEntered ignored: playerUserId is empty.")
            return
        end

        if battleId == nil or battleId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleEntered ignored: battleId is empty. userId=" .. playerUserId)
            return
        end

        if isvalid(battleEntity) == false then
            log_warning("[BattleFlowLogic] NotifyBattleEntered ignored: battleEntity is invalid. battleId=" .. battleId)
            return
        end

        self:EnterBattleClient(battleId, battleEntity, playerUserId)
        log("[BattleFlowLogic] NotifyBattleEntered battleId=" .. battleId .. ", userId=" .. playerUserId)
    end

    @ExecSpace("ServerOnly")
    method void NotifyBattleExited(string playerUserId, string battleId, string result)
        -- Sends the client-only exit-battle presentation command to one user.
        if playerUserId == nil or playerUserId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleExited ignored: playerUserId is empty.")
            return
        end

        if battleId == nil or battleId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleExited ignored: battleId is empty. userId=" .. playerUserId)
            return
        end

        if result == nil or result == "" then
            result = _BattleKeys.resultCancel
        end

        self:ExitBattleClient(battleId, result, playerUserId)
        log("[BattleFlowLogic] NotifyBattleExited battleId=" .. battleId .. ", result=" .. result .. ", userId=" .. playerUserId)
    end

    @ExecSpace("Client")
    method void EnterBattleClient(string battleId, Entity battleEntity)
        -- Client RPC wrapper; BattleClientLogic owns actual UI, control, and camera changes.
        -- playerUserId is supplied at the server call site as the RPC target, not in this signature.
        _BattleClientLogic:EnterBattle(battleId, battleEntity)
    end

    @ExecSpace("Client")
    method void ExitBattleClient(string battleId, string result)
        -- Client RPC wrapper; BattleClientLogic owns actual UI, control, and camera restoration.
        _BattleClientLogic:ExitBattle(battleId, result)
    end

end
