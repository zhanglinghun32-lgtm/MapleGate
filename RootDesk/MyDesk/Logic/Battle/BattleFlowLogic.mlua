@Logic
script BattleFlowLogic extends Logic

    -- Server-side battle orchestration boundary.
    -- It prepares or receives payloads, starts BattleSystem, and notifies BattleClientLogic by Client RPC.

    property table activeFieldBattlesByUser = {}
    property table activeBattleEntitiesByUser = {}

    @ExecSpace("ServerOnly")
    method boolean StartFieldBattle(Entity playerEntity, Entity targetEntity, string actionKey)
        -- Temporary compatibility adapter for confirmed field hits.
        if isvalid(playerEntity) == false or isvalid(targetEntity) == false then
            log_warning("[BattleFlowLogic] StartFieldBattle failed: player or target is invalid.")
            return false
        end

        if actionKey ~= "normalAttack" then
            log_warning("[BattleFlowLogic] StartFieldBattle rejected action=" .. tostring(actionKey))
            return false
        end

        local playerComponent = playerEntity.PlayerComponent
        if playerComponent == nil or playerComponent.UserId == nil or playerComponent.UserId == "" then
            log_warning("[BattleFlowLogic] StartFieldBattle failed: player UserId is empty.")
            return false
        end

        return self:RequestStartBattle({
            triggerType = "PlayerAttack",
            playerUserId = playerComponent.UserId,
            sponsorEntityId = playerEntity.Id,
            playerRefs = { playerEntity },
            enemyRefs = { targetEntity },
            allyRefs = {},
            sceneKey = "World",
            encounterKey = targetEntity.Name,
            battleRuleKey = "FieldEncounter",
            canEscape = true,
            openingActionKey = actionKey
        })
    end

    @ExecSpace("ServerOnly")
    method boolean RequestStartBattle(table request)
        if request == nil then
            log_warning("[BattleFlowLogic] RequestStartBattle failed: request is nil.")
            return false
        end

        local playerUserId = _DataUtil:GetTableString(request, "playerUserId", "")
        local sponsorEntityId = _DataUtil:GetTableString(request, "sponsorEntityId", "")
        local sponsorEntity = _EntityService:GetEntity(sponsorEntityId)
        if playerUserId == "" or isvalid(sponsorEntity) == false then
            log_warning("[BattleFlowLogic] RequestStartBattle failed: player or sponsor is invalid.")
            return false
        end

        local mapEntity = sponsorEntity.CurrentMap
        if isvalid(mapEntity) == false then
            log_warning("[BattleFlowLogic] RequestStartBattle failed: sponsor map is invalid. userId=" .. playerUserId)
            return false
        end

        if self:GetActiveBattleEntity(playerUserId) ~= nil or self.activeFieldBattlesByUser[playerUserId] ~= nil then
            log_warning("[BattleFlowLogic] RequestStartBattle ignored: battle already active. userId=" .. playerUserId)
            return false
        end

        local playerParty = self:BuildPlayerParty(request, sponsorEntity, mapEntity)
        local enemyParty = self:BuildEnemyParty(request, mapEntity)
        local allyParty = self:BuildAllyParty(request, mapEntity)
        if #playerParty == 0 or #enemyParty == 0 then
            log_warning("[BattleFlowLogic] RequestStartBattle failed: player or enemy roster is empty.")
            return false
        end

        local sequence = tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
        local battleId = _DataUtil:GetTableString(request, "battleId", "")
        if battleId == "" then
            battleId = "Field_" .. playerUserId .. "_" .. sequence
        end

        local payload = {
            battleId = battleId,
            triggerType = _DataUtil:GetTableString(request, "triggerType", ""),
            playerUserId = playerUserId,
            sponsorEntityId = sponsorEntity.Id,
            sceneKey = _DataUtil:GetTableString(request, "sceneKey", "World"),
            mapName = mapEntity.Name,
            encounterKey = _DataUtil:GetTableString(request, "encounterKey", ""),
            rewardKey = _DataUtil:GetTableString(request, "rewardKey", ""),
            battleRuleKey = _DataUtil:GetTableString(request, "battleRuleKey", "FieldEncounter"),
            canEscape = request.canEscape ~= false,
            maxTurnCount = tonumber(request.maxTurnCount) or 0,
            openingActionKey = _DataUtil:GetTableString(request, "openingActionKey", ""),
            sourceKey = _DataUtil:GetTableString(request, "sourceKey", ""),
            dialogueKey = _DataUtil:GetTableString(request, "dialogueKey", ""),
            playerParty = playerParty,
            enemyParty = enemyParty,
            allyParty = allyParty,
            environment = self:BuildEnvironmentFromMap(mapEntity)
        }

        local battleEntity = _SpawnService:SpawnByModelId(
            "battlesystem",
            "BattleSession_" .. sequence,
            Vector3(0, 0, 0),
            mapEntity
        )
        if isvalid(battleEntity) == false then
            log_warning("[BattleFlowLogic] RequestStartBattle failed: BattleSystem spawn returned invalid entity.")
            return false
        end

        self.activeFieldBattlesByUser[playerUserId] = battleId
        local started = self:StartBattle(payload, battleEntity)
        if started == false then
            self.activeFieldBattlesByUser[playerUserId] = nil
            _EntityService:Destroy(battleEntity)
            return false
        end

        log("[BattleFlowLogic] RequestStartBattle started. battleId=" .. battleId
            .. ", trigger=" .. tostring(payload.triggerType)
            .. ", players=" .. tostring(#playerParty)
            .. ", enemies=" .. tostring(#enemyParty)
            .. ", allies=" .. tostring(#allyParty))
        return true
    end

    @ExecSpace("ServerOnly")
    method table BuildPlayerParty(table request, Entity sponsorEntity, Entity mapEntity)
        local refs = request.playerRefs
        if refs == nil or #refs == 0 then
            refs = { sponsorEntity }
        end
        return self:BuildRoster(refs, _BattleKeys.actorTypePlayer, "Player", "Player", mapEntity)
    end

    @ExecSpace("ServerOnly")
    method table BuildEnemyParty(table request, Entity mapEntity)
        return self:BuildRoster(request.enemyRefs, _BattleKeys.actorTypeMonster, "Enemy", "AI", mapEntity)
    end

    @ExecSpace("ServerOnly")
    method table BuildAllyParty(table request, Entity mapEntity)
        return self:BuildRoster(request.allyRefs, _BattleKeys.actorTypeCompanion, "Ally", "AI", mapEntity)
    end

    @ExecSpace("ServerOnly")
    method table BuildRoster(any entityRefs, string defaultActorType, string teamId, string controlMode, Entity mapEntity)
        local roster = {}
        local seenEntityIds = {}
        if entityRefs == nil then
            return roster
        end

        for _, entityRef in ipairs(entityRefs) do
            local entity = self:ResolveEntityRef(entityRef)
            if isvalid(entity) and entity.CurrentMap == mapEntity and seenEntityIds[entity.Id] ~= true then
                local actor = entity:GetComponent("script.BattleActorCom")
                if actor ~= nil then
                    table.insert(roster, self:BuildActorEntry(entity, actor, defaultActorType, teamId, controlMode, #roster + 1))
                    seenEntityIds[entity.Id] = true
                else
                    log_warning("[BattleFlowLogic] BuildRoster skipped entity without BattleActorCom. entityId=" .. tostring(entity.Id))
                end
            end
        end
        return roster
    end

    @ExecSpace("ServerOnly")
    method Entity ResolveEntityRef(any entityRef)
        if entityRef == nil or entityRef == "" then
            return nil
        end
        if type(entityRef) == "string" then
            return _EntityService:GetEntity(entityRef)
        end
        if isvalid(entityRef) then
            return entityRef
        end
        return nil
    end

    @ExecSpace("ServerOnly")
    method table BuildActorEntry(Entity entity, any battleActor, string actorType, string teamId, string controlMode, integer slotIndex)
        return {
            actorId = entity.Id,
            entityId = entity.Id,
            actorType = actorType,
            teamId = teamId,
            controlMode = controlMode,
            configId = battleActor.configId,
            slotIndex = slotIndex,
            canBetray = false,
            skillKeys = self:GetActorSkillKeys(entity, battleActor)
        }
    end

    @ExecSpace("ServerOnly")
    method table GetActorSkillKeys(Entity entity, any battleActor)
        -- Player-owned learned skills take priority; other party members use actorConfig defaults.
        if isvalid(entity) and entity.PlayerComponent ~= nil then
            local userId = tostring(entity.PlayerComponent.UserId)
            if userId ~= "" and userId ~= "nil" then
                return _SkillLogic:GetLearnedSkillKeys(userId)
            end
        end

        local skillKeys = {}
        local actorConfig = _DataService:GetTable("actorConfig")
        if actorConfig == nil or battleActor == nil then
            return skillKeys
        end
        local actorRow = actorConfig:FindRow("actorKey", tostring(battleActor.configId))
        if actorRow == nil then
            return skillKeys
        end
        local naturalSkillKeys = _DataUtil:GetRowString(actorRow, "naturalSkillKeys", "")
        for skillKey in string.gmatch(naturalSkillKeys, "[^|]+") do
            table.insert(skillKeys, skillKey)
        end
        return skillKeys
    end

    @ExecSpace("ServerOnly")
    method table BuildEnvironmentFromMap(Entity mapEntity)
        -- Map-specific environment providers can extend this roster metadata later.
        return {
            weatherKey = "",
            terrainKey = "",
            terrainCells = {},
            mapObjects = {}
        }
    end

    @ExecSpace("ServerOnly")
    method boolean StartBattle(table payload, Entity battleEntity)
        -- Starts a prepared BattleSystem session and then enters battle mode on the owning client.
        if payload == nil then
            log_warning("[BattleFlowLogic] StartBattle failed: payload is nil.")
            return false
        end

        if isvalid(battleEntity) == false then
            log_warning("[BattleFlowLogic] StartBattle failed: battleEntity is invalid.")
            return false
        end

        ---@type BattleSystem
        local battleSystem = battleEntity:GetComponent("script.BattleSystem")
        if battleSystem == nil then
            log_warning("[BattleFlowLogic] StartBattle failed: BattleSystem component missing.")
            return false
        end

        local battleId = _DataUtil:GetTableString(payload, "battleId", "")
        local playerUserId = _DataUtil:GetTableString(payload, "playerUserId", "")

        if battleId == "" then
            log_warning("[BattleFlowLogic] StartBattle failed: battleId is empty.")
            return false
        end

        if playerUserId == "" then
            log_warning("[BattleFlowLogic] StartBattle failed: playerUserId is empty. battleId=" .. battleId)
            return false
        end

        local started = battleSystem:StartBattle(payload)
        if started == false then
            log_warning("[BattleFlowLogic] StartBattle failed inside BattleSystem. battleId=" .. battleId)
            return false
        end

        self.activeBattleEntitiesByUser[playerUserId] = battleEntity

        -- Only notify the client after the server session is valid.
        -- battleEntity crosses RPC so the client can read @Sync fields on BattleSystem.
        self:NotifyBattleEntered(playerUserId, battleId, battleEntity)
        log("[BattleFlowLogic] StartBattle battleId=" .. battleId .. ", userId=" .. playerUserId)
        return true
    end

    @ExecSpace("ServerOnly")
    method void HandleBattleFinished(string playerUserId, string battleId, string result)
        -- Receives battle completion from BattleSystem and exits battle mode on the owning client.
        if playerUserId == nil or playerUserId == "" then
            log_warning("[BattleFlowLogic] HandleBattleFinished ignored: playerUserId is empty. battleId=" .. tostring(battleId))
            return
        end

        if battleId == nil or battleId == "" then
            log_warning("[BattleFlowLogic] HandleBattleFinished ignored: battleId is empty. userId=" .. playerUserId)
            return
        end

        if result == nil or result == "" then
            result = _BattleKeys.resultCancel
        end

        if self.activeFieldBattlesByUser[playerUserId] == battleId then
            self.activeFieldBattlesByUser[playerUserId] = nil
        end
        self.activeBattleEntitiesByUser[playerUserId] = nil

        local playerEntity = _UserService:GetUserEntityByUserId(playerUserId)
        if isvalid(playerEntity) == true then
            local fieldNormalAttack = playerEntity:GetComponent("script.FieldNormalAttack")
            if fieldNormalAttack ~= nil then
                fieldNormalAttack:ResetAfterBattle()
            end
        end

        self:NotifyBattleExited(playerUserId, battleId, result)
        log("[BattleFlowLogic] HandleBattleFinished battleId=" .. battleId .. ", result=" .. result .. ", userId=" .. playerUserId)
    end

    @ExecSpace("ServerOnly")
    method Entity GetActiveBattleEntity(string userId)
        if userId == nil or userId == "" then
            return nil
        end
        local battleEntity = self.activeBattleEntitiesByUser[userId]
        if isvalid(battleEntity) then
            return battleEntity
        end
        self.activeBattleEntitiesByUser[userId] = nil
        return nil
    end

    @ExecSpace("ServerOnly")
    method void RefreshActiveBattleSkillCache(string userId, table skillKeys)
        -- Propagates a live learned-skill change into the current battle session cache.
        local battleEntity = self:GetActiveBattleEntity(userId)
        local userEntity = _UserService:GetUserEntityByUserId(userId)
        if isvalid(battleEntity) == false or isvalid(userEntity) == false then
            return
        end
        local battleSystem = battleEntity:GetComponent("script.BattleSystem")
        if battleSystem ~= nil then
            battleSystem:UpdateActorSkillKeys(userEntity.Id, skillKeys)
        end
    end

    @ExecSpace("ServerOnly")
    method void NotifyBattleEntered(string playerUserId, string battleId, Entity battleEntity)
        -- Sends the client-only enter-battle presentation command to one user.
        -- UI open is a one-shot Client RPC command — not driven by @Sync.
        if playerUserId == nil or playerUserId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleEntered ignored: playerUserId is empty.")
            return
        end

        if battleId == nil or battleId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleEntered ignored: battleId is empty. userId=" .. playerUserId)
            return
        end

        if isvalid(battleEntity) == false then
            log_warning("[BattleFlowLogic] NotifyBattleEntered ignored: battleEntity is invalid. battleId=" .. battleId)
            return
        end

        self:EnterBattleClient(battleId, battleEntity, playerUserId)
        log("[BattleFlowLogic] NotifyBattleEntered battleId=" .. battleId .. ", userId=" .. playerUserId)
    end

    @ExecSpace("ServerOnly")
    method void NotifyBattleExited(string playerUserId, string battleId, string result)
        -- Sends the client-only exit-battle presentation command to one user.
        if playerUserId == nil or playerUserId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleExited ignored: playerUserId is empty.")
            return
        end

        if battleId == nil or battleId == "" then
            log_warning("[BattleFlowLogic] NotifyBattleExited ignored: battleId is empty. userId=" .. playerUserId)
            return
        end

        if result == nil or result == "" then
            result = _BattleKeys.resultCancel
        end

        self:ExitBattleClient(battleId, result, playerUserId)
        log("[BattleFlowLogic] NotifyBattleExited battleId=" .. battleId .. ", result=" .. result .. ", userId=" .. playerUserId)
    end

    @ExecSpace("Client")
    method void EnterBattleClient(string battleId, Entity battleEntity)
        -- Client RPC wrapper; BattleClientLogic owns actual UI, control, and camera changes.
        -- playerUserId is supplied at the server call site as the RPC target, not in this signature.
        _BattleClientLogic:EnterBattle(battleId, battleEntity)
    end

    @ExecSpace("Client")
    method void ExitBattleClient(string battleId, string result)
        -- Client RPC wrapper; BattleClientLogic owns actual UI, control, and camera restoration.
        _BattleClientLogic:ExitBattle(battleId, result)
    end

end
