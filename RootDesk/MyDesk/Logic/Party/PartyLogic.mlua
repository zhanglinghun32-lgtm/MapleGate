@Logic
script PartyLogic extends Logic

    property string actorConfigDataSetName = "actorConfig"
    property any userParties = nil

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Initializes the per-user party cache.
        self.userParties = {}
        log("[PartyLogic] OnBeginPlay.")
    end

    @ExecSpace("ServerOnly")
    method void LoadUserData(string userId, table partyData)
        -- Loads one user's party data into the runtime cache.
        if userId == nil or userId == "" then
            log_warning("[PartyLogic] LoadUserData ignored: userId is empty.")
            return
        end

        if partyData == nil then
            partyData = self:CreateDefaultData()
        end

        if partyData.Members == nil then
            partyData.Members = {}
        end

        if partyData.Formation == nil then
            partyData.Formation = {}
        end

        -- Legacy saves may contain Party.Members but an empty Formation.
        if self:GetFormationCount(partyData.Formation) == 0 then
            for slotIndex = 1, 4 do
                local memberData = partyData.Members[slotIndex]
                if memberData ~= nil then
                    local actorKey = tostring(memberData.ActorKey or memberData.actorKey or memberData.configId or "")
                    if actorKey ~= "" then
                        partyData.Formation[slotIndex] = actorKey
                    end
                end
            end
        end

        -- Repair partially-created slots whose Party collections are both empty.
        if self:GetFormationCount(partyData.Formation) == 0 then
            partyData.Formation[1] = "playerWarrior"
            if partyData.Members[1] == nil then
                partyData.Members[1] = self:CreateActorState("playerWarrior", 1)
            end
            log_warning("[PartyLogic] LoadUserData repaired empty formation. userId=" .. userId)
        end

        local activeFieldSlot = tonumber(partyData.ActiveFieldSlot) or 1
        activeFieldSlot = math.floor(activeFieldSlot)
        if activeFieldSlot < 1 or activeFieldSlot > 4 or partyData.Formation[activeFieldSlot] == nil then
            activeFieldSlot = 1
        end
        partyData.ActiveFieldSlot = activeFieldSlot

        self.userParties[userId] = partyData
        log("[PartyLogic] LoadUserData. userId=" .. userId
            .. ", memberCount=" .. tostring(#partyData.Members)
            .. ", formationCount=" .. tostring(self:GetFormationCount(partyData.Formation))
            .. ", activeFieldSlot=" .. tostring(partyData.ActiveFieldSlot))
    end

    @ExecSpace("Server")
    method void RequestPartyUIRoster()
        local userId = senderUserId
        if userId == nil or userId == "" then
            log_warning("[PartyLogic] RequestPartyUIRoster ignored: senderUserId is empty.")
            return
        end

        local partyData = self:ExportUserData(userId)
        local roster = {}
        local playerEntity = _UserService:GetUserEntityByUserId(userId)
        local playerActorKey = ""
        if isvalid(playerEntity) and isvalid(playerEntity.BattleActorCom) then
            playerActorKey = playerEntity.BattleActorCom.configId
        end

        for slotIndex = 1, 4 do
            local actorKey = tostring(partyData.Formation[slotIndex] or "")
            if actorKey ~= "" then
                local rosterEntry = {}
                rosterEntry.actorId = actorKey
                rosterEntry.entityId = ""
                rosterEntry.isLocalPlayer = false
                if isvalid(playerEntity) and (actorKey == playerActorKey or slotIndex == partyData.ActiveFieldSlot) then
                    rosterEntry.entityId = playerEntity.Id
                    rosterEntry.isLocalPlayer = true
                end
                roster[slotIndex] = rosterEntry
            end
        end

        self:ReceivePartyUIRoster(roster, userId)
        log("[PartyLogic] RequestPartyUIRoster response. userId=" .. userId
            .. ", formationCount=" .. tostring(self:GetFormationCount(partyData.Formation)))
    end

    @ExecSpace("Client")
    method void ReceivePartyUIRoster(table roster)
        local partyUIEntity = _EntityService:GetEntityByPath("/ui/Party")
        if isvalid(partyUIEntity) == false or isvalid(partyUIEntity.PartyUICom) == false then
            log_warning("[PartyLogic] ReceivePartyUIRoster failed: PartyUICom not found.")
            return
        end

        partyUIEntity.PartyUICom:ApplyRoster(roster)
    end

    @ExecSpace("ServerOnly")
    method integer GetFormationCount(table formation)
        if formation == nil then
            return 0
        end

        local count = 0
        for slotIndex = 1, 4 do
            local actorKey = formation[slotIndex]
            if actorKey ~= nil and tostring(actorKey) ~= "" then
                count = count + 1
            end
        end
        return count
    end

    @ExecSpace("ServerOnly")
    method table ExportUserData(string userId)
        -- Returns the user's current party payload for saving.
        if self.userParties == nil then
            self.userParties = {}
        end

        local partyData = self.userParties[userId]
        if partyData == nil then
            partyData = self:CreateDefaultData()
            self.userParties[userId] = partyData
        end

        return partyData
    end

    @ExecSpace("ServerOnly")
    method table CreateDefaultData()
        -- Creates the default party for a new slot.
        local partyData = {}
        partyData.Members = {}
        partyData.Formation = {}
        partyData.ActiveFieldSlot = 1

        partyData.Members[1] = self:CreateActorState("playerWarrior", 1)
        partyData.Formation[1] = "playerWarrior"

        return partyData
    end

    @ExecSpace("ServerOnly")
    method table CreateActorState(string actorKey, integer level)
        -- Creates one actor state from actorConfig plus runtime defaults.
        local actorState = {}
        actorState.ActorKey = actorKey
        actorState.Level = level
        actorState.Exp = 0
        actorState.Hp = self:GetActorInteger(actorKey, "maxHp", 1)
        actorState.Mp = self:GetActorInteger(actorKey, "maxMp", 0)
        return actorState
    end

    @ExecSpace("ServerOnly")
    method string GetLeaderActorKey(string userId)
        -- Returns the actor key in the first formation slot.
        local partyData = self:ExportUserData(userId)
        if partyData.Formation == nil or partyData.Formation[1] == nil then
            return ""
        end

        return partyData.Formation[1]
    end

    @ExecSpace("ServerOnly")
    method boolean IsControlledFieldEntity(string userId, Entity actorEntity)
        -- Identifies the single field entity currently receiving player control.
        if userId == nil or userId == "" or isvalid(actorEntity) == false then
            return false
        end

        local userEntity = _UserService:GetUserEntityByUserId(userId)
        return isvalid(userEntity) and userEntity == actorEntity
    end

    @ExecSpace("ServerOnly")
    method integer GetActorInteger(string actorKey, string columnName, integer fallback)
        -- Reads an integer value from actorConfig.
        local dataSet = _DataService:GetTable(self.actorConfigDataSetName)
        if dataSet == nil then
            return fallback
        end

        local row = dataSet:FindRow("configId", actorKey)
        if row == nil then
            return fallback
        end

        local value = row:GetItem(columnName)
        if value == nil or value == "" then
            return fallback
        end

        local numberValue = tonumber(value)
        if numberValue == nil then
            return fallback
        end

        return math.floor(numberValue)
    end

end
