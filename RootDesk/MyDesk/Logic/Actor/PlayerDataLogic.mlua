@Logic
script PlayerDataLogic extends Logic

    -- SaveSlot JSON shape (what is persisted to UserDataStorage):
    --   docs/PlayerData/SaveSlotSchema.md  ← canonical field registry
    -- Actor slim fields also summarized in docs/Actor/ActorVariableExplain.md
    -- CollectSlotData() assembles the table; SaveSlotData() JSONEncodes it.
    --
    -- actorConfig supplies one initial job for a template.
    -- Player saves persist every acquired job under actor.jobs.

    property string worldSceneKey = "World"
    property string mainMenuSceneKey = "MainMenu"
    property string slotKeyPrefix = "Slot"
    property integer maxSlotIndex = 6
    property integer currentSchemaVersion = 6
    property any loadedSlotIndexes = nil
    property any slotDataCache = nil
    property any dirtyUsers = nil

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Initializes player-save runtime caches. Saving is explicit only.
        self.loadedSlotIndexes = {}
        self.slotDataCache = {}
        self.dirtyUsers = {}
        log("[PlayerDataLogic] OnBeginPlay. saveMode=ManualOnly")
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- Never writes dirty data on exit. A future confirmation UI will decide whether to save.
        log("[PlayerDataLogic] OnEndPlay. exit save skipped.")
    end

    @ExecSpace("Server")
    method void RequestContinueGame(integer slotIndex)
        -- Lets the owning client load a save slot before entering gameplay.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[PlayerDataLogic] RequestContinueGame ignored: senderUserId is empty.")
            return
        end

        self:ContinueGame(senderUserId, slotIndex)
    end

    @ExecSpace("Server")
    method void RequestNewGame(integer slotIndex)
        -- Lets the owning client reset a save slot before entering gameplay.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[PlayerDataLogic] RequestNewGame ignored: senderUserId is empty.")
            return
        end

        self:StartNewGame(senderUserId, slotIndex)
    end

    @ExecSpace("Server")
    method void RequestDeleteSlot(integer slotIndex)
        -- Deletes only the requesting user's selected save slot.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[PlayerDataLogic] RequestDeleteSlot ignored: senderUserId is empty.")
            return
        end

        self:DeleteSlot(senderUserId, slotIndex)
    end

    @ExecSpace("ServerOnly")
    method boolean DeleteSlot(string userId, integer slotIndex)
        if self:IsValidSlotIndex(slotIndex) == false then
            log_warning("[PlayerDataLogic] DeleteSlot failed: invalid slotIndex=" .. tostring(slotIndex))
            return false
        end

        local storage = _DataStorageService:GetUserDataStorage(userId)
        if storage == nil then
            log_warning("[PlayerDataLogic] DeleteSlot failed: storage is nil. userId=" .. tostring(userId))
            return false
        end

        local slotKey = self:GetSlotStorageKey(slotIndex)
        local errorCode = storage:DeleteAndWait(slotKey)
        if errorCode ~= 0 then
            log_warning("[PlayerDataLogic] DeleteSlot failed. userId=" .. userId
                .. ", slotKey=" .. slotKey
                .. ", errorCode=" .. tostring(errorCode))
            return false
        end

        if self.loadedSlotIndexes[userId] == slotIndex then
            self.loadedSlotIndexes[userId] = nil
            self.slotDataCache[userId] = nil
            self.dirtyUsers[userId] = nil
        end

        log("[PlayerDataLogic] DeleteSlot complete. userId=" .. userId .. ", slotKey=" .. slotKey)
        return true
    end

    @ExecSpace("Server")
    method void RequestSaveCurrentSlot()
        -- Lets the owning client immediately flush its currently loaded slot.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[PlayerDataLogic] RequestSaveCurrentSlot ignored: senderUserId is empty.")
            return
        end

        local saved = self:ForceFlushUser(senderUserId)
        log("[PlayerDataLogic] RequestSaveCurrentSlot userId=" .. senderUserId .. ", saved=" .. tostring(saved))
    end

    @ExecSpace("Server")
    method void RequestReturnToMenu()
        -- Returns to the main menu without saving; save and exit are separate actions.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[PlayerDataLogic] RequestReturnToMenu ignored: senderUserId is empty.")
            return
        end

        _GameplayFlowLogic:ReturnToMainMenuForUser(senderUserId, "ReturnToMenu")
        log("[PlayerDataLogic] RequestReturnToMenu complete without save. userId=" .. senderUserId)
    end

    @ExecSpace("ServerOnly")
    method boolean ContinueGame(string userId, integer slotIndex)
        -- Loads a slot from DataStorage, dispatches it to subsystem caches, then enters the world.
        if self:IsValidSlotIndex(slotIndex) == false then
            log_warning("[PlayerDataLogic] ContinueGame failed: invalid slotIndex=" .. tostring(slotIndex))
            return false
        end

        local slotData = self:LoadSlotData(userId, slotIndex)
        local createdVirtualSlot = false
        if slotData == nil then
            slotData = self:CreateDefaultSlotData()
            createdVirtualSlot = true
            log("[PlayerDataLogic] ContinueGame using default slot. userId=" .. userId .. ", slotIndex=" .. tostring(slotIndex))
        end

        self:ApplyLoadedSlotData(userId, slotIndex, slotData)
        if createdVirtualSlot == true then
            self:MarkDirty(userId)
        end
        local savedEntryPosition = self:GetSavedPlayerEntryPosition(slotData.PlayerPosition)
        if savedEntryPosition ~= nil then
            _GameplayFlowLogic:EnterWorldForUserAtPosition(userId, "ContinueGame", savedEntryPosition)
            log("[PlayerDataLogic] ContinueGame restoring position. userId=" .. userId .. ", entry=" .. tostring(savedEntryPosition))
        else
            _GameplayFlowLogic:EnterWorldForUser(userId, "ContinueGame")
            log_warning("[PlayerDataLogic] ContinueGame using default entry: saved position is missing. userId=" .. userId)
        end
        log("[PlayerDataLogic] ContinueGame complete. userId=" .. userId .. ", slotIndex=" .. tostring(slotIndex))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean StartNewGame(string userId, integer slotIndex)
        -- Resets a slot to default data, saves it, dispatches it, then enters the world.
        if self:IsValidSlotIndex(slotIndex) == false then
            log_warning("[PlayerDataLogic] StartNewGame failed: invalid slotIndex=" .. tostring(slotIndex))
            return false
        end

        local slotData = self:CreateDefaultSlotData()
        self:ApplyLoadedSlotData(userId, slotIndex, slotData)
        local saved = self:SaveSlotData(userId, slotIndex, slotData)
        if saved == false then
            log_warning("[PlayerDataLogic] StartNewGame stopped: initial save failed. userId=" .. userId)
            return false
        end
        _GameplayFlowLogic:EnterWorldForUser(userId, "StartNewGame")
        log("[PlayerDataLogic] StartNewGame complete. userId=" .. userId .. ", slotIndex=" .. tostring(slotIndex))
        return true
    end

    @ExecSpace("ServerOnly")
    method void ApplyLoadedSlotData(string userId, integer slotIndex, table slotData)
        -- Fans loaded slot sections out to each gameplay data Logic.
        if slotData == nil then
            slotData = self:CreateDefaultSlotData()
        end

        local createdVirtualActors = false
        local migratedActorJobs = false
        if slotData.Actors == nil or #slotData.Actors == 0 then
            slotData.Actors = self:CreateDefaultActorList()
            createdVirtualActors = true
        end
        for _, actorData in ipairs(slotData.Actors) do
            if self:NormalizeActorJobs(actorData) then
                migratedActorJobs = true
            end
        end

        if slotData.Party == nil then
            slotData.Party = _PartyLogic:CreateDefaultData()
        end
        if slotData.Inventory == nil then
            slotData.Inventory = _InventoryLogic:CreateEmptyData()
        end
        if slotData.Skill == nil then
            slotData.Skill = _SkillLogic:CreateDefaultData()
        end
        if slotData.Mission == nil then
            slotData.Mission = _MissionLogic:CreateDefaultData()
        end
        if slotData.MapState == nil then
            slotData.MapState = _LootDropLogic:CreateDefaultMapState()
        end

        self.loadedSlotIndexes[userId] = slotIndex
        self.slotDataCache[userId] = slotData
        self.dirtyUsers[userId] = nil

        _PartyLogic:LoadUserData(userId, slotData.Party)
        _InventoryLogic:LoadActorInventories(userId, slotData.Actors, slotData.Inventory)
        slotData.Inventory = _InventoryLogic:CreateEmptyData()
        _SkillLogic:LoadUserData(userId, slotData.Skill)
        _MissionLogic:LoadUserData(userId, slotData.Mission)
        _LootDropLogic:LoadUserMapState(userId, slotData.MapState)
        self:ApplyPrimaryActorToPlayer(userId, slotData.Actors)

        if createdVirtualActors == true or migratedActorJobs == true then
            self:MarkDirty(userId)
        end
        local formationCount = 0
        if slotData.Party.Formation ~= nil then
            formationCount = #slotData.Party.Formation
        end
        local itemCount = _InventoryLogic:GetAllActorItemStackCount(userId)
        log("[PlayerDataLogic] ApplyLoadedSlotData. userId=" .. userId
            .. ", slotIndex=" .. tostring(slotIndex)
            .. ", actorCount=" .. tostring(#slotData.Actors)
            .. ", formationCount=" .. tostring(formationCount)
            .. ", itemCount=" .. tostring(itemCount))
    end

    @ExecSpace("ServerOnly")
    method table LoadSlotData(string userId, integer slotIndex)
        -- Reads and deserializes one slot from UserDataStorage.
        local storage = _DataStorageService:GetUserDataStorage(userId)
        if storage == nil then
            log_warning("[PlayerDataLogic] LoadSlotData failed: storage is nil. userId=" .. tostring(userId))
            return nil
        end

        local slotKey = self:GetSlotStorageKey(slotIndex)
        local errorCode, rawData = storage:GetAndWait(slotKey)
        if errorCode ~= 0 then
            log_warning("[PlayerDataLogic] LoadSlotData failed. userId=" .. userId .. ", slotKey=" .. slotKey .. ", errorCode=" .. tostring(errorCode))
            return nil
        end

        if rawData == nil or rawData == "" then
            return nil
        end

        local slotData = nil
        if string.sub(rawData, 1, 1) == "{" then
            slotData = self:RestoreTableFromJson(_HttpService:JSONDecode(rawData))
        else
            slotData = _UtilLogic:StringToTable(rawData)
            log_warning("[PlayerDataLogic] LoadSlotData loaded legacy table-string payload. userId=" .. userId .. ", slotKey=" .. slotKey)
        end
        if slotData == nil then
            log_warning("[PlayerDataLogic] LoadSlotData failed: parse returned nil. userId=" .. userId .. ", slotKey=" .. slotKey)
            return nil
        end

        local loadedActor = nil
        local loadedActiveJob = nil
        if slotData.Actors ~= nil then
            loadedActor = slotData.Actors[1]
            if loadedActor ~= nil then
                local loadedJobs = loadedActor.jobs or loadedActor.Jobs or {}
                local loadedActiveIndex = math.floor(tonumber(
                    loadedActor.activeJobIndex or loadedActor.ActiveJobIndex
                ) or 1)
                loadedActiveJob = loadedJobs[loadedActiveIndex] or loadedJobs[1]
                if loadedActiveJob == nil and (loadedActor.jobType ~= nil or loadedActor.JobType ~= nil) then
                    loadedActiveJob = {
                        jobType = loadedActor.jobType or loadedActor.JobType,
                        level = loadedActor.level or loadedActor.Level
                    }
                end
            end
        end
        log("[PlayerDataLogic] LoadSlotData. userId=" .. userId
            .. ", slotKey=" .. slotKey
            .. ", configId=" .. tostring(loadedActor ~= nil and (loadedActor.configId or loadedActor.ConfigId) or nil)
            .. ", activeJob=" .. tostring(loadedActiveJob ~= nil and loadedActiveJob.jobType or nil)
            .. ", jobLevel=" .. tostring(loadedActiveJob ~= nil and loadedActiveJob.level or nil))
        return slotData
    end

    @ExecSpace("ServerOnly")
    method boolean SaveSlotData(string userId, integer slotIndex, table slotData)
        -- Serializes and writes one complete slot payload to UserDataStorage.
        local storage = _DataStorageService:GetUserDataStorage(userId)
        if storage == nil then
            log_warning("[PlayerDataLogic] SaveSlotData failed: storage is nil. userId=" .. tostring(userId))
            return false
        end

        local slotKey = self:GetSlotStorageKey(slotIndex)
        local serializableSlotData = self:PrepareTableForJson(slotData)
        local rawData = _HttpService:JSONEncode(serializableSlotData)
        local errorCode = storage:SetAndWait(slotKey, rawData)
        if errorCode ~= 0 then
            log_warning("[PlayerDataLogic] SaveSlotData failed. userId=" .. userId .. ", slotKey=" .. slotKey .. ", errorCode=" .. tostring(errorCode))
            return false
        end

        self.dirtyUsers[userId] = nil
        self.slotDataCache[userId] = slotData
        local savedActor = nil
        local savedActiveJob = nil
        if slotData.Actors ~= nil then
            savedActor = slotData.Actors[1]
            if savedActor ~= nil then
                savedActiveJob = self:GetActiveActorJob(savedActor)
            end
        end
        log("[PlayerDataLogic] SaveSlotData. userId=" .. userId
            .. ", slotKey=" .. slotKey
            .. ", configId=" .. tostring(savedActor ~= nil and (savedActor.configId or savedActor.ConfigId) or nil)
            .. ", activeJob=" .. tostring(savedActiveJob ~= nil and savedActiveJob.jobType or nil)
            .. ", jobLevel=" .. tostring(savedActiveJob ~= nil and savedActiveJob.level or nil))
        return true
    end

    @ExecSpace("ServerOnly")
    method table CollectSlotData(string userId)
        -- Builds the SaveSlot table written to storage. Field list: docs/PlayerData/SaveSlotSchema.md
        local slotData = self.slotDataCache[userId]
        if slotData == nil then
            slotData = self:CreateDefaultSlotData()
        end

        slotData.Version = self.currentSchemaVersion
        if slotData.Profile == nil then
            slotData.Profile = self:CreateDefaultProfileData()
        end

        slotData.Party = _PartyLogic:ExportUserData(userId)
        -- Root Inventory remains an empty compatibility shell in schema v5.
        slotData.Inventory = _InventoryLogic:CreateEmptyData()
        slotData.Skill = _SkillLogic:ExportUserData(userId)
        slotData.Mission = _MissionLogic:ExportUserData(userId)
        slotData.Actors = self:CollectPlayerActors(userId, slotData.Actors)
        slotData.Actors = _InventoryLogic:ExportActorInventories(userId, slotData.Actors)
        slotData.PlayerPosition = self:CollectPlayerPosition(userId, slotData.PlayerPosition)
        slotData.MapState = _LootDropLogic:ExportUserMapState(userId)

        return slotData
    end

    @ExecSpace("ServerOnly")
    method table CreateDefaultSlotData()
        -- Default SaveSlot shape for a new game. Keys must match SaveSlotSchema.md.
        local slotData = {}
        slotData.Version = self.currentSchemaVersion
        slotData.Profile = self:CreateDefaultProfileData()
        slotData.PlayerPosition = self:CreateDefaultPlayerPositionData()
        slotData.Party = _PartyLogic:CreateDefaultData()
        slotData.Inventory = _InventoryLogic:CreateEmptyData()
        slotData.Skill = _SkillLogic:CreateDefaultData()
        slotData.Mission = _MissionLogic:CreateDefaultData()
        slotData.Actors = self:CreateDefaultActorList()
        slotData.MapState = _LootDropLogic:CreateDefaultMapState()
        return slotData
    end

    @ExecSpace("ServerOnly")
    method table CreateDefaultActorList()
        -- Slim Actors[] seed only. No current hp/mp/stamina (not persisted).
        local actors = {}
        local actorData = {}
        actorData.configId = "playerWarrior"
        local actorRow = nil
        local actorConfig = _DataService:GetTable("actorConfig")
        if actorConfig ~= nil then
            actorRow = actorConfig:FindRow("configId", actorData.configId)
        end
        local initialJobType = "Warrior"
        local initialJobLevel = 1
        if actorRow ~= nil then
            initialJobType = _DataUtil:GetRowString(actorRow, "jobType", initialJobType)
            initialJobLevel = _DataUtil:GetRowInteger(actorRow, "level", initialJobLevel)
        end
        actorData.jobs = {
            {
                jobType = initialJobType,
                level = math.max(1, initialJobLevel)
            }
        }
        actorData.activeJobIndex = 1
        actorData.constitution = actorRow ~= nil and _DataUtil:GetRowInteger(actorRow, "constitution", 10) or 10
        actorData.dexterity = actorRow ~= nil and _DataUtil:GetRowInteger(actorRow, "dexterity", 6) or 6
        actorData.intelligence = actorRow ~= nil and _DataUtil:GetRowInteger(actorRow, "intelligence", 4) or 4
        actorData.will = actorRow ~= nil and _DataUtil:GetRowInteger(actorRow, "will", 6) or 6
        actorData.perception = actorRow ~= nil and _DataUtil:GetRowInteger(actorRow, "perception", 5) or 5
        actorData.inventory = _InventoryLogic:CreateDefaultData()
        actors[1] = actorData
        return actors
    end

    @ExecSpace("ServerOnly")
    method boolean NormalizeActorJobs(table actorData)
        if actorData == nil then
            return false
        end

        local migrated = false
        local normalizedJobs = {}
        for _, savedJob in ipairs(actorData.jobs or actorData.Jobs or {}) do
            local jobType = tostring(savedJob.jobType or savedJob.JobType or savedJob.job or "")
            if jobType ~= "" then
                table.insert(normalizedJobs, {
                    jobType = jobType,
                    level = math.max(1, math.floor(tonumber(savedJob.level or savedJob.Level) or 1))
                })
            end
        end

        if #normalizedJobs == 0 then
            local legacyJobType = tostring(actorData.jobType or actorData.JobType or "")
            local legacyLevel = math.max(1, math.floor(tonumber(actorData.level or actorData.Level) or 1))
            if legacyJobType == "" then
                local actorConfig = _DataService:GetTable("actorConfig")
                local actorRow = actorConfig ~= nil and actorConfig:FindRow(
                    "configId",
                    tostring(actorData.configId or actorData.ConfigId or "")
                ) or nil
                if actorRow ~= nil then
                    legacyJobType = _DataUtil:GetRowString(actorRow, "jobType", "")
                    legacyLevel = _DataUtil:GetRowInteger(actorRow, "level", legacyLevel)
                end
            end
            if legacyJobType ~= "" then
                table.insert(normalizedJobs, {
                    jobType = legacyJobType,
                    level = math.max(1, legacyLevel)
                })
            end
            migrated = true
        end

        local activeJobIndex = math.floor(tonumber(actorData.activeJobIndex or actorData.ActiveJobIndex) or 1)
        if activeJobIndex < 1 or activeJobIndex > #normalizedJobs then
            activeJobIndex = 1
            migrated = true
        end

        actorData.jobs = normalizedJobs
        actorData.activeJobIndex = activeJobIndex
        if actorData.jobType ~= nil or actorData.JobType ~= nil
            or actorData.level ~= nil or actorData.Level ~= nil
            or actorData.Jobs ~= nil or actorData.ActiveJobIndex ~= nil then
            migrated = true
        end
        actorData.jobType = nil
        actorData.JobType = nil
        actorData.level = nil
        actorData.Level = nil
        actorData.Jobs = nil
        actorData.ActiveJobIndex = nil
        return migrated
    end

    @ExecSpace("ServerOnly")
    method table GetActiveActorJob(table actorData)
        self:NormalizeActorJobs(actorData)
        local activeJobIndex = math.floor(tonumber(actorData.activeJobIndex) or 1)
        return actorData.jobs[activeJobIndex] or actorData.jobs[1]
    end

    @ExecSpace("ServerOnly")
    method table BuildRuntimeActorState(table saveActor)
        -- Expands slim Actors[] with derived fields + full current resources for BattleActorCom.
        -- Current hp/mp/stamina are never read from Save; always filled to max (buff TBD).
        local runtime = {}
        if saveActor == nil then
            return runtime
        end

        runtime.configId = tostring(saveActor.configId or saveActor.ConfigId or "")
        local activeJob = self:GetActiveActorJob(saveActor)
        runtime.jobType = tostring(activeJob ~= nil and activeJob.jobType or "")
        runtime.level = math.max(1, math.floor(tonumber(activeJob ~= nil and activeJob.level or 1) or 1))
        runtime.constitution = math.max(0, math.floor(tonumber(saveActor.constitution or saveActor.Constitution) or 0))
        runtime.dexterity = math.max(0, math.floor(tonumber(saveActor.dexterity or saveActor.Dexterity) or 0))
        runtime.intelligence = math.max(0, math.floor(tonumber(saveActor.intelligence or saveActor.Intelligence) or 0))
        runtime.will = math.max(0, math.floor(tonumber(saveActor.will or saveActor.Will) or 0))
        runtime.perception = math.max(0, math.floor(tonumber(saveActor.perception or saveActor.Perception) or 0))

        local derived = self:ComputeActorDerivedFromAttributes(runtime)
        runtime.maxHp = derived.maxHp
        runtime.maxMp = derived.maxMp
        runtime.maxStamina = derived.maxStamina
        runtime.defense = derived.defense
        runtime.speed = derived.speed
        runtime.jumpForce = derived.jumpForce
        runtime.castRange = derived.castRange
        runtime.mpCostRate = derived.mpCostRate
        runtime.recoveryRate = derived.recoveryRate
        runtime.resistance = derived.resistance
        runtime.effectPotency = derived.effectPotency
        runtime.effectHitRate = derived.effectHitRate
        runtime.criticalRate = derived.criticalRate

        -- Session currents for Com Create/Import / battle entry — not Save fields.
        runtime.hp = runtime.maxHp
        runtime.mp = runtime.maxMp
        runtime.stamina = runtime.maxStamina
        return runtime
    end

    @ExecSpace("ServerOnly")
    method table ComputeActorDerivedFromAttributes(table actorAttrs)
        -- Player-only: five attributes -> derived fields. Never outputs attack.
        -- TODO(ActorDerivedFormula): Replace every value below when the balance
        -- formulas for level / jobType / five primary attributes are finalized.
        local derived = {}
        derived.maxHp = 1
        derived.maxMp = 1
        derived.maxStamina = 1
        derived.defense = 1
        derived.speed = 1
        derived.jumpForce = 1
        derived.castRange = 1
        derived.mpCostRate = 1
        derived.recoveryRate = 1
        derived.resistance = 1
        derived.effectPotency = 1
        derived.effectHitRate = 1
        derived.criticalRate = 1
        return derived
    end

    @ExecSpace("ServerOnly")
    method integer ClampCurrentResource(any currentValue, integer maxValue)
        -- Clamps a session current into 0 .. maxValue; nil means full.
        -- Not used for Save persistence (currents are never stored in Actors[]).
        if maxValue == nil then
            maxValue = 0
        end
        if currentValue == nil or currentValue == "" then
            return maxValue
        end
        local numberValue = tonumber(currentValue)
        if numberValue == nil then
            return maxValue
        end
        return math.max(0, math.min(math.floor(numberValue), maxValue))
    end

    @ExecSpace("ServerOnly")
    method table CollectPlayerPosition(string userId, table fallbackPosition)
        -- Captures the authoritative player's current world position for SaveSlot persistence.
        local userEntity = _UserService:GetUserEntityByUserId(userId)
        if isvalid(userEntity) == false or isvalid(userEntity.TransformComponent) == false then
            log_warning("[PlayerDataLogic] CollectPlayerPosition fallback: player transform missing. userId=" .. tostring(userId))
            return fallbackPosition or self:CreateDefaultPlayerPositionData()
        end

        local worldPosition = userEntity.TransformComponent.WorldPosition
        local playerPosition = {}
        playerPosition.X = worldPosition.x
        playerPosition.Y = worldPosition.y
        playerPosition.Z = worldPosition.z
        log("[PlayerDataLogic] CollectPlayerPosition. userId=" .. userId
            .. ", x=" .. tostring(playerPosition.X)
            .. ", y=" .. tostring(playerPosition.Y)
            .. ", z=" .. tostring(playerPosition.Z))
        return playerPosition
    end

    @ExecSpace("ServerOnly")
    method table CreateDefaultPlayerPositionData()
        -- Creates the backward-compatible position payload for new and legacy slots.
        local playerPosition = {}
        playerPosition.X = 0
        playerPosition.Y = 0
        playerPosition.Z = 0
        return playerPosition
    end

    @ExecSpace("ServerOnly")
    method Vector2 GetSavedPlayerEntryPosition(table playerPosition)
        -- Converts persisted world coordinates to the 2D map-transition position.
        if playerPosition == nil or playerPosition.X == nil or playerPosition.Y == nil then
            return nil
        end

        local positionX = tonumber(playerPosition.X)
        local positionY = tonumber(playerPosition.Y)
        if positionX == nil or positionY == nil then
            return nil
        end

        return Vector2(positionX, positionY)
    end

    @ExecSpace("ServerOnly")
    method table PrepareTableForJson(table sourceTable)
        -- Clones save data and marks empty tables so MSW JSONEncode can infer a shape.
        local resultTable = {}
        local entryCount = 0
        for key, value in pairs(sourceTable) do
            entryCount = entryCount + 1
            if type(value) == "table" then
                resultTable[key] = self:PrepareTableForJson(value)
            else
                resultTable[key] = value
            end
        end

        if entryCount == 0 then
            resultTable.__MSWEmptyTable = true
        end
        return resultTable
    end

    @ExecSpace("ServerOnly")
    method table RestoreTableFromJson(table sourceTable)
        -- Removes serialization-only empty-table markers after JSON decoding.
        if sourceTable == nil then
            return nil
        end

        if sourceTable.__MSWEmptyTable == true then
            sourceTable.__MSWEmptyTable = nil
            return sourceTable
        end

        for key, value in pairs(sourceTable) do
            if type(value) == "table" then
                sourceTable[key] = self:RestoreTableFromJson(value)
            end
        end
        return sourceTable
    end

    @ExecSpace("ServerOnly")
    method boolean ArePlayerPositionsEqual(table leftPosition, table rightPosition)
        -- Ignores sub-pixel physics jitter when deciding whether a save is dirty.
        if leftPosition == nil or rightPosition == nil then
            return false
        end

        local epsilon = 0.0001
        return math.abs((tonumber(leftPosition.X) or 0) - (tonumber(rightPosition.X) or 0)) <= epsilon
            and math.abs((tonumber(leftPosition.Y) or 0) - (tonumber(rightPosition.Y) or 0)) <= epsilon
            and math.abs((tonumber(leftPosition.Z) or 0) - (tonumber(rightPosition.Z) or 0)) <= epsilon
    end

    @ExecSpace("ServerOnly")
    method boolean ApplyPrimaryActorToPlayer(string userId, table actors)
        -- Applies the first saved actor to the user's DefaultPlayer runtime entity.
        if actors == nil or actors[1] == nil then
            log_warning("[PlayerDataLogic] ApplyPrimaryActorToPlayer failed: Actors[1] is missing. userId=" .. tostring(userId))
            return false
        end

        local userEntity = _UserService:GetUserEntityByUserId(userId)
        if isvalid(userEntity) == false then
            log_warning("[PlayerDataLogic] ApplyPrimaryActorToPlayer failed: user entity missing. userId=" .. tostring(userId))
            return false
        end

        local battleActor = userEntity:GetComponent("BattleActorCom")
        if isvalid(battleActor) == false then
            userEntity:AddComponent("BattleActorCom")
            battleActor = userEntity:GetComponent("BattleActorCom")
        end

        if isvalid(battleActor) == false then
            log_warning("[PlayerDataLogic] ApplyPrimaryActorToPlayer failed: BattleActorCom missing. userId=" .. userId)
            return false
        end

        -- Player combat stats come from SaveSlot, not OnBeginPlay ApplyConfig.
        -- See docs/Actor/BattleActorInitPaths.md and ActorVariableExplain.md.
        battleActor.statsSource = "Save"

        -- Every playable Actor owns normalAttack. The component maps A to the native
        -- Attack action and performs server-authoritative world-field hit detection.
        local fieldNormalAttack = userEntity:GetComponent("script.FieldNormalAttack")
        if isvalid(fieldNormalAttack) == false then
            userEntity:AddComponent("FieldNormalAttack")
            fieldNormalAttack = userEntity:GetComponent("script.FieldNormalAttack")
        end
        if isvalid(fieldNormalAttack) == false then
            log_warning("[PlayerDataLogic] ApplyPrimaryActorToPlayer failed: FieldNormalAttack missing. userId=" .. userId)
            return false
        end

        local lootTestInput = userEntity:GetComponent("script.LootTestInputComponent")
        if isvalid(lootTestInput) == false then
            userEntity:AddComponent("LootTestInputComponent")
            lootTestInput = userEntity:GetComponent("script.LootTestInputComponent")
        end
        if isvalid(lootTestInput) == false then
            log_warning("[PlayerDataLogic] ApplyPrimaryActorToPlayer failed: LootTestInputComponent missing. userId=" .. userId)
            return false
        end

        -- Client-side battle skill presentation runner. It is attached to the runtime player
        -- so BattleClientLogic can play avatar actions and effects without owning entity visuals.
        local skillPresentation = userEntity:GetComponent("script.BattleSkillPresentationComponent")
        if isvalid(skillPresentation) == false then
            userEntity:AddComponent("BattleSkillPresentationComponent")
            skillPresentation = userEntity:GetComponent("script.BattleSkillPresentationComponent")
        end
        if isvalid(skillPresentation) == false then
            log_warning("[PlayerDataLogic] ApplyPrimaryActorToPlayer failed: BattleSkillPresentationComponent missing. userId=" .. userId)
            return false
        end

        local runtimeActor = self:BuildRuntimeActorState(actors[1])
        battleActor:ImportSaveData(runtimeActor)
        log("[PlayerDataLogic] ApplyPrimaryActorToPlayer complete. userId=" .. userId
            .. ", statsSource=" .. tostring(battleActor.statsSource)
            .. ", configId=" .. tostring(battleActor.configId)
            .. ", hp=" .. tostring(battleActor.hp)
            .. "/" .. tostring(battleActor.maxHp)
            .. ", mp=" .. tostring(battleActor.mp)
            .. "/" .. tostring(battleActor.maxMp))
        return true
    end

    @ExecSpace("ServerOnly")
    method table CollectPlayerActors(string userId, table fallbackActors)
        -- Exports the live DefaultPlayer actor state for the next SaveSlot flush.
        local userEntity = _UserService:GetUserEntityByUserId(userId)
        if isvalid(userEntity) == false then
            return fallbackActors or self:CreateDefaultActorList()
        end

        local battleActor = userEntity:GetComponent("BattleActorCom")
        if isvalid(battleActor) == false then
            return fallbackActors or self:CreateDefaultActorList()
        end

        local actors = fallbackActors or {}
        local previousInventory = nil
        local previousJobs = nil
        local previousActiveJobIndex = 1
        if actors[1] ~= nil then
            self:NormalizeActorJobs(actors[1])
            previousInventory = actors[1].inventory
            previousJobs = actors[1].jobs
            previousActiveJobIndex = actors[1].activeJobIndex
        end
        local exportedActor = battleActor:ExportSaveData()
        exportedActor.jobs = previousJobs or {}
        exportedActor.activeJobIndex = previousActiveJobIndex
        if #exportedActor.jobs == 0 then
            exportedActor.jobs[1] = {
                jobType = tostring(exportedActor.jobType or ""),
                level = math.max(1, math.floor(tonumber(exportedActor.level) or 1))
            }
            exportedActor.activeJobIndex = 1
        else
            local activeJob = exportedActor.jobs[exportedActor.activeJobIndex] or exportedActor.jobs[1]
            activeJob.jobType = tostring(exportedActor.jobType or activeJob.jobType or "")
            activeJob.level = math.max(1, math.floor(tonumber(exportedActor.level or activeJob.level) or 1))
        end
        exportedActor.jobType = nil
        exportedActor.level = nil
        actors[1] = exportedActor
        actors[1].inventory = previousInventory or _InventoryLogic:CreateEmptyData()
        return actors
    end

    @ExecSpace("ServerOnly")
    method table CreateDefaultProfileData()
        -- Creates non-system-specific slot metadata.
        local profileData = {}
        profileData.DisplayName = "Player"
        profileData.PlayTimeSeconds = 0
        profileData.LastSceneKey = self.worldSceneKey
        return profileData
    end

    @ExecSpace("ServerOnly")
    method void MarkDirty(string userId)
        -- Marks the loaded user's slot as needing a future save.
        if userId == nil or userId == "" then
            return
        end

        self.dirtyUsers[userId] = true
    end

    @ExecSpace("ServerOnly")
    method void FlushDirtyUsers()
        -- Saves all loaded users that have dirty subsystem data.
        for userId, isDirty in pairs(self.dirtyUsers) do
            if isDirty == true then
                self:FlushUser(userId)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method boolean FlushUser(string userId)
        -- Saves one dirty loaded user's slot.
        local slotIndex = self.loadedSlotIndexes[userId]
        if slotIndex == nil then
            log_warning("[PlayerDataLogic] FlushUser ignored: no loaded slot. userId=" .. tostring(userId))
            self.dirtyUsers[userId] = nil
            return false
        end

        local cachedSlotData = self.slotDataCache[userId]
        if cachedSlotData == nil then
            cachedSlotData = self:CreateDefaultSlotData()
            self.slotDataCache[userId] = cachedSlotData
        end

        local currentPosition = self:CollectPlayerPosition(userId, cachedSlotData.PlayerPosition)
        if self:ArePlayerPositionsEqual(cachedSlotData.PlayerPosition, currentPosition) == false then
            cachedSlotData.PlayerPosition = currentPosition
            self:MarkDirty(userId)
        end

        if self.dirtyUsers[userId] ~= true then
            log("[PlayerDataLogic] FlushUser skipped unchanged data. userId=" .. userId)
            return true
        end

        local slotData = self:CollectSlotData(userId)
        return self:SaveSlotData(userId, slotIndex, slotData)
    end

    @ExecSpace("ServerOnly")
    method boolean ForceFlushUser(string userId)
        -- Collects every subsystem and writes the loaded slot for an explicit save action.
        local slotIndex = self.loadedSlotIndexes[userId]
        if slotIndex == nil then
            log_warning("[PlayerDataLogic] ForceFlushUser ignored: no loaded slot. userId=" .. tostring(userId))
            return false
        end

        local slotData = self:CollectSlotData(userId)
        self.slotDataCache[userId] = slotData
        self.dirtyUsers[userId] = true

        local partyCount = 0
        if slotData.Party ~= nil and slotData.Party.Formation ~= nil then
            partyCount = #slotData.Party.Formation
        end
        local actorCount = 0
        if slotData.Actors ~= nil then
            actorCount = #slotData.Actors
        end
        local itemCount = _InventoryLogic:GetAllActorItemStackCount(userId)

        log("[PlayerDataLogic] ForceFlushUser collected. userId=" .. userId
            .. ", partyCount=" .. tostring(partyCount)
            .. ", actorCount=" .. tostring(actorCount)
            .. ", itemCount=" .. tostring(itemCount))
        return self:SaveSlotData(userId, slotIndex, slotData)
    end

    @ExecSpace("ServerOnly")
    method string GetSlotStorageKey(integer slotIndex)
        -- Builds the DataStorage key for one save slot.
        return self.slotKeyPrefix .. tostring(slotIndex)
    end

    @ExecSpace("ServerOnly")
    method boolean IsValidSlotIndex(integer slotIndex)
        -- Checks the supported player-save slot range.
        return slotIndex >= 1 and slotIndex <= self.maxSlotIndex
    end

end
