@Logic
script InventoryLogic extends Logic

    property string inventoryConfigDataSetName = "inventoryConfig"
    property string consumableConfigDataSetName = "consumableConfig"
    property any userInventories = nil
    property any userActorInventories = nil

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Initializes the per-user inventory cache.
        self.userInventories = {}
        self.userActorInventories = {}
        log("[InventoryLogic] OnBeginPlay.")
    end

    @ExecSpace("ServerOnly")
    method void LoadActorInventories(string userId, table actors, table legacyInventory)
        -- Loads every saved actor inventory; legacy root Inventory migrates to Actors[1].
        if userId == nil or userId == "" then
            return
        end
        if actors == nil then
            actors = {}
        end

        local actorInventories = {}
        for actorIndex, actorData in ipairs(actors) do
            local inventoryData = actorData.inventory
            if inventoryData == nil and actorIndex == 1 and legacyInventory ~= nil then
                inventoryData = legacyInventory
                log("[InventoryLogic] Migrated legacy root Inventory to Actors[1]. userId=" .. userId)
            end
            if inventoryData == nil then
                inventoryData = self:CreateEmptyData()
            end
            self:NormalizeInventoryData(inventoryData)
            actorData.inventory = inventoryData
            actorInventories[actorIndex] = {
                ActorIndex = actorIndex,
                ActorKey = tostring(actorData.configId or actorData.ConfigId or ("Actor" .. tostring(actorIndex))),
                Inventory = inventoryData
            }
        end

        if #actorInventories == 0 then
            actorInventories[1] = {
                ActorIndex = 1,
                ActorKey = "playerWarrior",
                Inventory = legacyInventory or self:CreateDefaultData()
            }
            self:NormalizeInventoryData(actorInventories[1].Inventory)
        end

        self.userActorInventories[userId] = actorInventories
        self.userInventories[userId] = actorInventories[1].Inventory
        self:PublishInventorySnapshot(userId)
        log("[InventoryLogic] LoadActorInventories. userId=" .. userId
            .. ", actorCount=" .. tostring(#actorInventories)
            .. ", itemCount=" .. tostring(self:GetAllActorItemStackCount(userId)))
    end

    @ExecSpace("ServerOnly")
    method void LoadUserData(string userId, table inventoryData)
        -- Legacy compatibility entry point for slots without actor inventories.
        if userId == nil or userId == "" then
            log_warning("[InventoryLogic] LoadUserData ignored: userId is empty.")
            return
        end

        if inventoryData == nil then
            inventoryData = self:CreateDefaultData()
        end

        self:NormalizeInventoryData(inventoryData)
        self:LoadActorInventories(userId, {}, inventoryData)
    end

    @ExecSpace("ServerOnly")
    method table ExportUserData(string userId)
        -- Legacy root Inventory export. Actor inventories are authoritative in schema v5.
        if self.userInventories == nil then
            self.userInventories = {}
        end

        local inventoryData = self.userInventories[userId]
        if inventoryData == nil then
            inventoryData = self:CreateDefaultData()
            self.userInventories[userId] = inventoryData
        end

        return inventoryData
    end

    @ExecSpace("ServerOnly")
    method table ExportActorInventories(string userId, table actors)
        -- Writes every runtime actor inventory back into its matching Actors[] entry.
        if actors == nil then
            actors = {}
        end
        local actorInventories = self:GetActorInventories(userId)
        for actorIndex, actorEntry in ipairs(actorInventories) do
            if actors[actorIndex] ~= nil then
                actors[actorIndex].inventory = actorEntry.Inventory
            end
        end
        return actors
    end

    @ExecSpace("ServerOnly")
    method table CreateDefaultData()
        -- Creates the default inventory for a new slot.
        local inventoryData = {}
        inventoryData.Items = {}
        inventoryData.Equipped = {}

        inventoryData.Items[1] = self:CreateItemStack("hpPotionSmall", 5)
        inventoryData.Items[2] = self:CreateItemStack("mpPotionSmall", 3)
        inventoryData.Items[3] = self:CreateItemStack("sealedLetter", 1)

        return inventoryData
    end

    @ExecSpace("ServerOnly")
    method table CreateEmptyData()
        local inventoryData = {}
        inventoryData.Items = {}
        inventoryData.Equipped = {}
        return inventoryData
    end

    @ExecSpace("ServerOnly")
    method void NormalizeInventoryData(table inventoryData)
        if inventoryData.Items == nil then
            inventoryData.Items = {}
        end
        if inventoryData.Equipped == nil then
            inventoryData.Equipped = {}
        end
    end

    @ExecSpace("ServerOnly")
    method table GetActorInventories(string userId)
        if self.userActorInventories == nil then
            self.userActorInventories = {}
        end
        local actorInventories = self.userActorInventories[userId]
        if actorInventories == nil then
            local primaryInventory = self:ExportUserData(userId)
            actorInventories = {{
                ActorIndex = 1,
                ActorKey = "playerWarrior",
                Inventory = primaryInventory
            }}
            self.userActorInventories[userId] = actorInventories
        end
        return actorInventories
    end

    @ExecSpace("ServerOnly")
    method integer GetActiveActorIndex(string userId)
        -- Formation selects pickup ownership only; it never limits aggregate display.
        local actorInventories = self:GetActorInventories(userId)
        local partyData = _PartyLogic:ExportUserData(userId)
        local activeFieldSlot = math.floor(tonumber(partyData.ActiveFieldSlot) or 1)
        local activeActorKey = ""
        if partyData.Formation ~= nil then
            activeActorKey = tostring(partyData.Formation[activeFieldSlot] or "")
        end
        for actorIndex, actorEntry in ipairs(actorInventories) do
            if activeActorKey ~= "" and actorEntry.ActorKey == activeActorKey then
                return actorIndex
            end
        end
        return 1
    end

    @ExecSpace("ServerOnly")
    method table CreateItemStack(string itemKey, integer count)
        -- Creates a compact stack table for save data.
        local itemStack = {}
        itemStack.ItemKey = itemKey
        itemStack.Count = count
        return itemStack
    end

    @ExecSpace("ServerOnly")
    method boolean AddItem(string userId, string itemKey, integer count)
        -- Adds an item to existing stacks, creates new stacks, and marks the slot dirty.
        if userId == nil or userId == "" or itemKey == nil or itemKey == "" or count <= 0 then
            log_warning("[InventoryLogic] AddItem rejected invalid arguments.")
            return false
        end

        local itemRow = self:FindItemRow(itemKey)
        if itemRow == nil then
            log_warning("[InventoryLogic] AddItem failed: itemConfig missing. itemKey=" .. itemKey)
            return false
        end

        local maxStack = self:GetInteger(itemRow, "maxStack", 1)
        if maxStack <= 0 then
            maxStack = 1
        end

        local actorInventories = self:GetActorInventories(userId)
        local actorIndex = self:GetActiveActorIndex(userId)
        local inventoryData = actorInventories[actorIndex].Inventory
        local remaining = count
        local highestIndex = 0
        for slotIndex, itemStack in pairs(inventoryData.Items) do
            if type(slotIndex) == "number" and slotIndex > highestIndex then
                highestIndex = slotIndex
            end
            if itemStack ~= nil and itemStack.ItemKey == itemKey and itemStack.Count < maxStack then
                local available = maxStack - itemStack.Count
                local addedCount = math.min(available, remaining)
                itemStack.Count = itemStack.Count + addedCount
                remaining = remaining - addedCount
                if remaining <= 0 then
                    break
                end
            end
        end

        while remaining > 0 do
            local stackCount = math.min(maxStack, remaining)
            highestIndex = highestIndex + 1
            inventoryData.Items[highestIndex] = self:CreateItemStack(itemKey, stackCount)
            remaining = remaining - stackCount
        end

        _PlayerDataLogic:MarkDirty(userId)
        self:PublishInventorySnapshot(userId)
        log("[InventoryLogic] AddItem. userId=" .. userId
            .. ", itemKey=" .. itemKey
            .. ", actorIndex=" .. tostring(actorIndex)
            .. ", count=" .. tostring(count)
            .. ", totalCount=" .. tostring(self:GetItemCount(userId, itemKey)))
        return true
    end

    @ExecSpace("ServerOnly")
    method integer GetItemCount(string userId, string itemKey)
        -- Returns the total quantity across all owned actors, including reserves.
        local totalCount = 0
        for _, actorEntry in ipairs(self:GetActorInventories(userId)) do
            for _, itemStack in pairs(actorEntry.Inventory.Items) do
                if itemStack ~= nil and itemStack.ItemKey == itemKey then
                    totalCount = totalCount + (tonumber(itemStack.Count) or 0)
                end
            end
        end
        return math.floor(totalCount)
    end

    @ExecSpace("ServerOnly")
    method integer GetAllActorItemStackCount(string userId)
        local count = 0
        for _, actorEntry in ipairs(self:GetActorInventories(userId)) do
            for _, itemStack in pairs(actorEntry.Inventory.Items) do
                if itemStack ~= nil then
                    count = count + 1
                end
            end
        end
        return count
    end

    @ExecSpace("Server")
    method void RequestUseItem(integer actorIndex, integer slotIndex)
        -- Lets the owning client request item usage by inventory slot index.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[InventoryLogic] RequestUseItem ignored: senderUserId is empty.")
            return
        end

        self:UseItem(senderUserId, actorIndex, slotIndex)
    end

    @ExecSpace("Server")
    method void RequestInventorySnapshot()
        -- Returns the authoritative inventory view to the requesting client.
        if senderUserId == nil or senderUserId == "" then
            log_warning("[InventoryLogic] RequestInventorySnapshot ignored: senderUserId is empty.")
            return
        end

        self:PublishInventorySnapshot(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method boolean UseItem(string userId, integer actorIndex, integer slotIndex)
        -- Applies a consumable item from one cached inventory slot.
        local actorInventories = self:GetActorInventories(userId)
        if actorIndex <= 0 or actorInventories[actorIndex] == nil then
            log_warning("[InventoryLogic] UseItem failed: invalid actor. userId=" .. tostring(userId)
                .. ", actorIndex=" .. tostring(actorIndex))
            return false
        end
        local inventoryData = actorInventories[actorIndex].Inventory
        if slotIndex <= 0 or inventoryData.Items == nil or inventoryData.Items[slotIndex] == nil then
            log_warning("[InventoryLogic] UseItem failed: invalid slot. userId=" .. tostring(userId) .. ", slotIndex=" .. tostring(slotIndex))
            return false
        end

        local itemStack = inventoryData.Items[slotIndex]
        if itemStack.Count == nil or itemStack.Count <= 0 then
            log_warning("[InventoryLogic] UseItem failed: stack is empty. userId=" .. userId .. ", slotIndex=" .. tostring(slotIndex))
            return false
        end

        local itemRow = self:FindItemRow(itemStack.ItemKey)
        if itemRow == nil then
            log_warning("[InventoryLogic] UseItem failed: itemConfig missing. itemKey=" .. tostring(itemStack.ItemKey))
            return false
        end

        local usable = self:GetBoolean(itemRow, "usable", false)
        local consumableKey = self:GetString(itemRow, "consumableConfigKey", "")
        if usable == false or consumableKey == "" then
            log_warning("[InventoryLogic] UseItem failed: item is not consumable. itemKey=" .. tostring(itemStack.ItemKey))
            return false
        end

        local consumableRow = self:FindConsumableRow(consumableKey)
        if consumableRow == nil then
            log_warning("[InventoryLogic] UseItem failed: consumableConfig missing. key=" .. consumableKey)
            return false
        end

        local effectType = self:GetString(consumableRow, "effectType", "")
        local value = self:GetInteger(consumableRow, "value", 0)
        itemStack.Count = itemStack.Count - 1

        if itemStack.Count <= 0 then
            inventoryData.Items[slotIndex] = nil
        end

        _PlayerDataLogic:MarkDirty(userId)
        self:PublishInventorySnapshot(userId)
        log("[InventoryLogic] UseItem. userId=" .. userId .. ", itemKey=" .. tostring(itemStack.ItemKey) .. ", effectType=" .. effectType .. ", value=" .. tostring(value))
        return true
    end

    @ExecSpace("ServerOnly")
    method void PublishInventorySnapshot(string userId)
        -- Converts sparse save slots into a dense RPC-safe presentation payload.
        if userId == nil or userId == "" then
            return
        end

        local snapshot = {}
        for actorIndex, actorEntry in ipairs(self:GetActorInventories(userId)) do
            for slotIndex, itemStack in pairs(actorEntry.Inventory.Items or {}) do
                if type(slotIndex) == "number" and itemStack ~= nil then
                    table.insert(snapshot, {
                        ActorIndex = actorIndex,
                        ActorKey = actorEntry.ActorKey,
                        SlotIndex = math.floor(slotIndex),
                        ItemKey = tostring(itemStack.ItemKey or ""),
                        Count = math.floor(tonumber(itemStack.Count) or 0)
                    })
                end
            end
        end

        table.sort(snapshot, function(left, right)
            if left.ActorIndex ~= right.ActorIndex then
                return left.ActorIndex < right.ActorIndex
            end
            return left.SlotIndex < right.SlotIndex
        end)
        self:NotifyInventoryChangedClient(snapshot, userId)
        log("[InventoryLogic] PublishInventorySnapshot. userId=" .. userId .. ", itemCount=" .. tostring(#snapshot))
    end

    @ExecSpace("Client")
    method void NotifyInventoryChangedClient(table items)
        -- Forwards the server snapshot to the registered inventory UI on this client.
        local inventoryUIEntity = _UIManagerLogic:GetUIEntity("Inventory")
        if isvalid(inventoryUIEntity) == false then
            log_warning("[InventoryLogic] NotifyInventoryChangedClient failed: Inventory UI missing.")
            return
        end

        local inventoryUI = inventoryUIEntity:GetComponent("script.InventoryUICom")
        if inventoryUI == nil then
            log_warning("[InventoryLogic] NotifyInventoryChangedClient failed: InventoryUICom missing.")
            return
        end

        inventoryUI:RefreshInventory(items)
    end

    @ExecSpace("ServerOnly")
    method any FindItemRow(string itemKey)
        -- Finds one row in inventoryConfig by item key.
        local dataSet = _DataService:GetTable(self.inventoryConfigDataSetName)
        if dataSet == nil then
            log_warning("[InventoryLogic] inventoryConfig DataSet not found.")
            return nil
        end

        return dataSet:FindRow("itemKey", itemKey)
    end

    @ExecSpace("ServerOnly")
    method any FindConsumableRow(string consumableKey)
        -- Finds one row in consumableConfig by consumable key.
        local dataSet = _DataService:GetTable(self.consumableConfigDataSetName)
        if dataSet == nil then
            log_warning("[InventoryLogic] consumableConfig DataSet not found.")
            return nil
        end

        return dataSet:FindRow("consumableKey", consumableKey)
    end

    @ExecSpace("ServerOnly")
    method string GetString(any row, string columnName, string fallback)
        -- Reads a string cell with a fallback.
        local value = row:GetItem(columnName)
        if value == nil or value == "" then
            return fallback
        end

        return value
    end

    @ExecSpace("ServerOnly")
    method integer GetInteger(any row, string columnName, integer fallback)
        -- Reads an integer cell with a fallback.
        local value = row:GetItem(columnName)
        if value == nil or value == "" then
            return fallback
        end

        local numberValue = tonumber(value)
        if numberValue == nil then
            return fallback
        end

        return math.floor(numberValue)
    end

    @ExecSpace("ServerOnly")
    method boolean GetBoolean(any row, string columnName, boolean fallback)
        -- Reads a boolean-like string cell with a fallback.
        local value = row:GetItem(columnName)
        if value == nil or value == "" then
            return fallback
        end

        return value == "true" or value == "True" or value == "1"
    end

end
