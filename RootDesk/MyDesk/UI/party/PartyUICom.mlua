@Component
script PartyUICom extends Component

    @HideFromInspector
    property Entity memberSlot1 = nil

    @HideFromInspector
    property Entity memberSlot2 = nil

    @HideFromInspector
    property Entity memberSlot3 = nil

    @HideFromInspector
    property Entity memberSlot4 = nil

    @HideFromInspector
    property Entity closeButton = nil

    @HideFromInspector
    property Entity teamTag1 = "6580b25f-1517-44b2-936a-1fcccdbfc24b"

    @HideFromInspector
    property Entity teamTag2 = "de61d8c0-0b2a-43d5-8497-80f9d5f9dcd8"

    @HideFromInspector
    property Entity teamTag3 = "f02e71a2-7dcb-49c5-9759-14bd8c866221"

    @HideFromInspector
    property Entity checkButton = "734c4c78-bb99-4223-867c-4f62144bcc5a"

    @HideFromInspector
    property any closeButtonHandler = nil

    @HideFromInspector
    property any teamTag1Handler = nil

    @HideFromInspector
    property any teamTag2Handler = nil

    @HideFromInspector
    property any teamTag3Handler = nil

    @HideFromInspector
    property any checkButtonHandler = nil

    property integer focusedTeamIndex = 1
    property string normalTagRuid = "bc1521e28905416a8955f7d695abeadd"
    property string focusedTagRuid = "94019c4726ab4ae6b5241995e88cdf61"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        if isvalid(self.closeButton) then
            self.closeButtonHandler = self.closeButton:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        end
        if isvalid(self.teamTag1) then
            self.teamTag1Handler = self.teamTag1:ConnectEvent(ButtonClickEvent, self.OnTeamTag1Clicked)
        end
        if isvalid(self.teamTag2) then
            self.teamTag2Handler = self.teamTag2:ConnectEvent(ButtonClickEvent, self.OnTeamTag2Clicked)
        end
        if isvalid(self.teamTag3) then
            self.teamTag3Handler = self.teamTag3:ConnectEvent(ButtonClickEvent, self.OnTeamTag3Clicked)
        end
        if isvalid(self.checkButton) then
            self.checkButtonHandler = self.checkButton:ConnectEvent(ButtonClickEvent, self.OnCheckClicked)
        end
        self:SetFocusedTeam(1)
        self:RequestRosterRefresh()
        log("[PartyUICom] Ready. focusedTeamIndex=" .. tostring(self.focusedTeamIndex))
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if isvalid(self.closeButton) and self.closeButtonHandler ~= nil then
            self.closeButton:DisconnectEvent(ButtonClickEvent, self.closeButtonHandler)
            self.closeButtonHandler = nil
        end
        if isvalid(self.teamTag1) and self.teamTag1Handler ~= nil then
            self.teamTag1:DisconnectEvent(ButtonClickEvent, self.teamTag1Handler)
            self.teamTag1Handler = nil
        end
        if isvalid(self.teamTag2) and self.teamTag2Handler ~= nil then
            self.teamTag2:DisconnectEvent(ButtonClickEvent, self.teamTag2Handler)
            self.teamTag2Handler = nil
        end
        if isvalid(self.teamTag3) and self.teamTag3Handler ~= nil then
            self.teamTag3:DisconnectEvent(ButtonClickEvent, self.teamTag3Handler)
            self.teamTag3Handler = nil
        end
        if isvalid(self.checkButton) and self.checkButtonHandler ~= nil then
            self.checkButton:DisconnectEvent(ButtonClickEvent, self.checkButtonHandler)
            self.checkButtonHandler = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked(ButtonClickEvent event)
        _UIManagerLogic:CloseUI("Party")
    end

    @ExecSpace("ClientOnly")
    method void OnTeamTag1Clicked(ButtonClickEvent event)
        self:SetFocusedTeam(1)
    end

    @ExecSpace("ClientOnly")
    method void OnTeamTag2Clicked(ButtonClickEvent event)
        self:SetFocusedTeam(2)
    end

    @ExecSpace("ClientOnly")
    method void OnTeamTag3Clicked(ButtonClickEvent event)
        self:SetFocusedTeam(3)
    end

    @ExecSpace("ClientOnly")
    method void OnCheckClicked(ButtonClickEvent event)
        _PartyLogic:RequestConfirmTeam(self.focusedTeamIndex)
        log("[PartyUICom] Requested sortie team confirmation. teamIndex=" .. tostring(self.focusedTeamIndex))
    end

    @ExecSpace("ClientOnly")
    method void SetFocusedTeam(integer teamIndex)
        if teamIndex < 1 or teamIndex > 3 then
            log_warning("[PartyUICom] Invalid team index=" .. tostring(teamIndex))
            return
        end

        self.focusedTeamIndex = teamIndex
        self:SetTagFocused(self.teamTag1, teamIndex == 1)
        self:SetTagFocused(self.teamTag2, teamIndex == 2)
        self:SetTagFocused(self.teamTag3, teamIndex == 3)
        log("[PartyUICom] Focused team changed. teamIndex=" .. tostring(teamIndex))
    end

    @ExecSpace("ClientOnly")
    method void SetTagFocused(Entity tagEntity, boolean isFocused)
        if isvalid(tagEntity) == false or isvalid(tagEntity.SpriteGUIRendererComponent) == false then
            return
        end

        if isFocused then
            tagEntity.SpriteGUIRendererComponent.ImageRUID = self.focusedTagRuid
        else
            tagEntity.SpriteGUIRendererComponent.ImageRUID = self.normalTagRuid
        end
    end

    @ExecSpace("ClientOnly")
    method void RequestRosterRefresh()
        _PartyLogic:RequestPartyUIRoster()
        log("[PartyUICom] Requested roster refresh.")
    end

    @ExecSpace("ClientOnly")
    method void ApplyRoster(table roster)
        for slotIndex = 1, 4 do
            local rosterEntry = nil
            if roster ~= nil then
                rosterEntry = roster[slotIndex]
            end

            if rosterEntry ~= nil and rosterEntry.isLocalPlayer == true and isvalid(_UserService.LocalPlayer) then
                self:SetMemberEntity(slotIndex, _UserService.LocalPlayer)
            else
                self:SetMember(slotIndex, rosterEntry)
            end
        end
        log("[PartyUICom] Applied roster. slot1Visible=" .. tostring(isvalid(self.memberSlot1) and self.memberSlot1.Enable))
    end

    @ExecSpace("ClientOnly")
    method void SetMembers(table memberInputs)
        for slotIndex = 1, 4 do
            local memberInput = nil
            if memberInputs ~= nil then
                memberInput = memberInputs[slotIndex]
            end
            self:SetMember(slotIndex, memberInput)
        end
    end

    @ExecSpace("ClientOnly")
    method void SetMember(integer slotIndex, any memberInput)
        if memberInput == nil then
            local emptySlot = self:GetMemberSlotEntity(slotIndex)
            if emptySlot ~= nil then
                emptySlot.Enable = false
            end
            return
        end

        local memberComponent = self:GetMemberComponent(slotIndex)
        if memberComponent == nil then
            log_warning("[PartyUICom] Invalid member slot index=" .. tostring(slotIndex))
            return
        end
        memberComponent:SetMemberInput(memberInput)
    end

    @ExecSpace("ClientOnly")
    method void SetMemberEntity(integer slotIndex, Entity memberEntity)
        local memberComponent = self:GetMemberComponent(slotIndex)
        if memberComponent ~= nil then
            memberComponent:SetMemberEntity(memberEntity)
        end
    end

    @ExecSpace("ClientOnly")
    method void SetMemberEntityId(integer slotIndex, string entityId)
        local memberComponent = self:GetMemberComponent(slotIndex)
        if memberComponent ~= nil then
            memberComponent:SetMemberEntityId(entityId)
        end
    end

    @ExecSpace("ClientOnly")
    method void SetMemberActorId(integer slotIndex, string actorId)
        local memberComponent = self:GetMemberComponent(slotIndex)
        if memberComponent ~= nil then
            memberComponent:SetMemberActorId(actorId)
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearMembers()
        for slotIndex = 1, 4 do
            local memberComponent = self:GetMemberComponent(slotIndex)
            if memberComponent ~= nil then
                memberComponent:ClearMember()
            end
        end
    end

    @ExecSpace("ClientOnly")
    method Entity GetMemberSlotEntity(integer slotIndex)
        if slotIndex == 1 then
            return self.memberSlot1
        elseif slotIndex == 2 then
            return self.memberSlot2
        elseif slotIndex == 3 then
            return self.memberSlot3
        elseif slotIndex == 4 then
            return self.memberSlot4
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method Component GetMemberComponent(integer slotIndex)
        local slotEntity = self:GetMemberSlotEntity(slotIndex)

        if slotEntity == nil then
            return nil
        end
        -- Disabled empty slots must remain reusable when a member is later added.
        slotEntity.Enable = true
        return slotEntity.SingleMemberUICom
    end

end
