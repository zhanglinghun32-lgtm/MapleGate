@Component
@ExecSpace("ClientOnly")
script BattleUIComponent extends Component

    -- Client-only battle HUD controller bound on ui/BattleUI.ui root.
    -- Reads @Sync state from the server-spawned BattleSystem entity; sends player input via Server RPC.
    -- Does not open/close the UI shell — BattleClientLogic + UIManagerLogic own that.

    property string defaultActionKey = "normalAttack"
    property boolean inputEnabled = false
    property string syncedBattlePhase = "None"
    property string syncedCurrentActorId = ""
	property table syncActorMap = {}
    property string selectedSkillKey = ""
    property any selectedSponsorActorData = nil

    property any battleSystem = nil

    property Entity skillGrid = "752d0ebe-20fa-4ca1-af7a-ef6096e20b26"
    property Entity skillDescriptionPopupEntity = "f2aa244a-ba2d-4da6-872c-c7515931aa49"

    property table skillSlotButtons = {}
    property table skillSlotClickHandlers = {}
    property table skillKeysByIndex = {}

    method void OnBeginPlay()
        -- Binds skill slot buttons; session attach happens when battle mode opens.
        log("[BattleUIComponent] OnBeginPlay.")
        self.skillKeysByIndex[1] = self.defaultActionKey
        self:BindButtons()
    end

    method void OnEndPlay()
        -- Releases handlers owned by this UI component.
        self:UnbindButtons()
        self:DetachBattleSession()
        log("[BattleUIComponent] OnEndPlay.")
    end

    method void AttachBattleSession(Entity battleEntity)
        -- Stores the server-spawned battle entity and applies the current synced BattleSystem snapshot.
        if isvalid(battleEntity) == false then
            log_warning("[BattleUIComponent] AttachBattleSession ignored: battleEntity is invalid.")
            return
        end
        self.battleSystem = battleEntity:GetComponent("script.BattleSystem")
        if self.battleSystem == nil then
            log_warning("[BattleUIComponent] AttachBattleSession failed: BattleSystem missing on battleEntity.")
            return
        end

        self:ApplyBattleSystemSnapshot()
        log("[BattleUIComponent] AttachBattleSession battleId=" .. tostring(self.battleSystem.battleId))
    end

    method void DetachBattleSession()
        -- Clears cached battle references when battle mode closes.
        self.battleSystem = nil
        self.inputEnabled = false
        self.syncedBattlePhase = _BattleKeys.phaseNone
        self.syncedCurrentActorId = ""
        self.syncActorMap = {}
        self:ClearSkillSelection()
        self:RefreshSkillSlotInteractable()
        log("[BattleUIComponent] DetachBattleSession.")
    end

    method void OnSyncProperty(string name, any value)
        -- Handles battle display updates forwarded from BattleSystem @Sync replication.
        -- MSW only auto-invokes OnSyncProperty on the component that owns the @Sync property,
        -- so BattleSystem forwards phase/actor sync through BattleClientLogic to reach this UI script.
        if name == "battlePhase" then
            self.syncedBattlePhase = tostring(value)
            self:RefreshInputState()
            log("[BattleUIComponent] OnSyncProperty battlePhase=" .. self.syncedBattlePhase)
            return
        end

        if name == "currentActorId" then
            self.syncedCurrentActorId = tostring(value)
            self:RefreshInputState()
            log("[BattleUIComponent] OnSyncProperty currentActorId=" .. self.syncedCurrentActorId)
            return
        end
    end

    method void ApplyBattleSystemSnapshot()
        -- Reads the latest replicated BattleSystem fields after attach or reconnect.

        self.syncedBattlePhase = tostring(self.battleSystem.battlePhase)
        self.syncedCurrentActorId = tostring(self.battleSystem.currentActorId)
		self.syncActorMap = (self.battleSystem.actorMap)
        self:RefreshInputState()
    end

    method void RefreshInputState()
        -- Enables skill input only while the server phase allows player action on the current actor.
        local canInput = false
        if self.battleSystem ~= nil and self.syncedBattlePhase == _BattleKeys.phaseAwaitingInput then
            canInput = self.syncedCurrentActorId ~= ""
        end

        self.inputEnabled = canInput
        if self.inputEnabled == false then
            self:ClearSkillSelection()
        end
        self:RefreshSkillSlotInteractable()
    end

    method void RefreshSkillSlotInteractable()
        -- Skill browsing is local UI state; only empty slots are disabled.
        local enabledCount = 0
        for skillIndex, skillSlotButton in pairs(self.skillSlotButtons) do
            local skillKey = self.skillKeysByIndex[skillIndex]
            local hasSkill = skillKey ~= nil and skillKey ~= ""
            skillSlotButton.Enable = hasSkill
            if hasSkill then
                enabledCount = enabledCount + 1
            end
        end
        log("[BattleUIComponent] RefreshSkillSlotInteractable enabledCount=" .. tostring(enabledCount) .. ", inputEnabled=" .. tostring(self.inputEnabled))
    end

    method void BindButtons()
        -- Discovers sequential SkillSlot entities and binds them to one indexed handler.
        self:UnbindButtons()

        if isvalid(self.skillGrid) == false then
            log_warning("[BattleUIComponent] BindButtons failed: skillGrid is invalid.")
            return
        end

        local skillIndex = 1
        while true do
            local slotEntity = self:GetSkillSlotEntity(skillIndex)
            if isvalid(slotEntity) == false then
                break
            end

            local skillSlotButton = slotEntity.ButtonComponent
            if skillSlotButton == nil then
                log_warning("[BattleUIComponent] ButtonComponent missing. slot=" .. slotEntity.Name)
            else
                local capturedSkillIndex = skillIndex
                local clickHandler = slotEntity:ConnectEvent(ButtonClickEvent, function(event)
                    self:OnSkillSlotClicked(event, capturedSkillIndex)
                end)
                self.skillSlotButtons[skillIndex] = skillSlotButton
                self.skillSlotClickHandlers[skillIndex] = clickHandler
            end

            skillIndex = skillIndex + 1
        end

        self:RefreshSkillSlotInteractable()
        log("[BattleUIComponent] BindButtons complete. slotCount=" .. tostring(skillIndex - 1))
    end

    method void UnbindButtons()
        -- Disconnects every indexed skill-slot handler created by BindButtons.
        for skillIndex, clickHandler in pairs(self.skillSlotClickHandlers) do
            local skillSlotButton = self.skillSlotButtons[skillIndex]
            if clickHandler ~= nil and skillSlotButton ~= nil then
                skillSlotButton.Entity:DisconnectEvent(ButtonClickEvent, clickHandler)
            end
        end

        self.skillSlotButtons = {}
        self.skillSlotClickHandlers = {}
    end

    method Entity GetSkillSlotEntity(integer skillIndex)
        -- Resolves the legacy SkillSlot_01 name and the regular SkillSlot_N sequence.
        local slotName = "SkillSlot_" .. tostring(skillIndex)
        if skillIndex == 1 then
            slotName = "SkillSlot_01"
        end

        return self.skillGrid:GetChildByName(slotName, false)
    end

    method void SetSkillSlotKey(integer skillIndex, string skillKey)
        -- Updates the skill assigned to one slot without changing its click binding.
        if skillIndex < 1 then
            log_warning("[BattleUIComponent] SetSkillSlotKey ignored: skillIndex must be positive.")
            return
        end

        self.skillKeysByIndex[skillIndex] = skillKey
        self:RefreshSkillSlotInteractable()
    end

    method void RequestBattleAction(string actionKey, table targetIds)
        -- Sends one player action to the authoritative BattleSystem on the server.
        if self.inputEnabled == false then
            log_warning("[BattleUIComponent] RequestBattleAction ignored: input disabled. phase=" .. self.syncedBattlePhase)
            return
        end

        if self.battleSystem == nil then
            log_warning("[BattleUIComponent] RequestBattleAction ignored: battleSystem is nil.")
            return
        end

        if self.syncedCurrentActorId == "" then
            log_warning("[BattleUIComponent] RequestBattleAction ignored: currentActorId is empty.")
            return
        end

        if actionKey == nil or actionKey == "" then
            log_warning("[BattleUIComponent] RequestBattleAction ignored: actionKey is empty.")
            return
        end

        if targetIds == nil then
            targetIds = {}
        end

        log("[BattleUIComponent] RequestBattleAction actor=" .. self.syncedCurrentActorId .. ", action=" .. actionKey)
        self.battleSystem:RequestAction(self.syncedCurrentActorId, actionKey, targetIds)
    end

    method void RequestBattleActionAtWorldPosition(string actionKey, Vector2 targetPoint)
        -- Sends one player action using a world-space point that the server expands into range targets.
        if targetPoint == nil then
            log_warning("[BattleUIComponent] RequestBattleActionAtWorldPosition ignored: targetPoint is nil.")
            return
        end

        local actionContext = {}
        actionContext.TargetPoint = targetPoint
        actionContext.HasTargetPoint = true
        actionContext.TargetIds = {}
        self:RequestBattleActionWithContext(actionKey, actionContext)
    end

    method void RequestBattleActionAtScreenPosition(string actionKey, Vector2 screenPoint)
        -- Converts a screen click to a world point before sending the action request.
        if screenPoint == nil then
            log_warning("[BattleUIComponent] RequestBattleActionAtScreenPosition ignored: screenPoint is nil.")
            return
        end

        local worldPoint = _UILogic:ScreenToWorldPosition(screenPoint)
        self:RequestBattleActionAtWorldPosition(actionKey, worldPoint)
    end

    method void RequestBattleActionWithContext(string actionKey, table actionContext)
        -- Sends one player action with a flexible target context table.
        if self.inputEnabled == false then
            log_warning("[BattleUIComponent] RequestBattleActionWithContext ignored: input disabled. phase=" .. self.syncedBattlePhase)
            return
        end

        if self.battleSystem == nil then
            log_warning("[BattleUIComponent] RequestBattleActionWithContext ignored: battleSystem is nil.")
            return
        end

        if self.syncedCurrentActorId == "" then
            log_warning("[BattleUIComponent] RequestBattleActionWithContext ignored: currentActorId is empty.")
            return
        end

        if actionKey == nil or actionKey == "" then
            log_warning("[BattleUIComponent] RequestBattleActionWithContext ignored: actionKey is empty.")
            return
        end

        if actionContext == nil then
            actionContext = {}
        end

        log("[BattleUIComponent] RequestBattleActionWithContext actor=" .. self.syncedCurrentActorId .. ", action=" .. actionKey)
        self.battleSystem:RequestActionWithContext(self.syncedCurrentActorId, actionKey, actionContext)
    end

    method void OnSkillSlotClicked(ButtonClickEvent event, integer skillIndex)
        -- Selection is local UI state. RequestAction happens only after target confirmation.
        local skillSlotButton = self.skillSlotButtons[skillIndex]
        local skillKey = self.skillKeysByIndex[skillIndex]
        if skillSlotButton == nil then
            log_warning("[BattleUIComponent] OnSkillSlotClicked ignored: slot missing. index=" .. tostring(skillIndex))
            return
        end
        if skillKey == nil or skillKey == "" then
            log_warning("[BattleUIComponent] OnSkillSlotClicked ignored: skill key missing. index=" .. tostring(skillIndex))
            return
        end

        log("[BattleUIComponent] OnSkillSlotClicked index=" .. tostring(skillIndex) .. ", key=" .. skillKey)
        self:SelectSkill(skillKey, skillSlotButton.Entity)
    end

    method void SelectSkill(string skillKey, Entity slotEntity)
        -- Allows local skill browsing even before action submission becomes legal.
        if skillKey == nil or skillKey == "" then
            log_warning("[BattleUIComponent] SelectSkill ignored: skillKey is empty.")
            return
        end

        if isvalid(slotEntity) == false then
            log_warning("[BattleUIComponent] SelectSkill ignored: slotEntity is invalid.")
            return
        end

        local sponsorActorData = nil
        if self.syncActorMap ~= nil then
            sponsorActorData = self.syncActorMap[self.syncedCurrentActorId]
        end
        if sponsorActorData == nil then
            sponsorActorData = {}
            log_warning("[BattleUIComponent] SelectSkill sponsor actorData missing. actor=" .. self.syncedCurrentActorId)
        end

        self.selectedSkillKey = skillKey
        self.selectedSponsorActorData = sponsorActorData

        local skillDescriptionPopup = self:GetSkillDescriptionPopup()
        if skillDescriptionPopup ~= nil then
            skillDescriptionPopup:ShowSkill(skillKey, sponsorActorData, slotEntity)
        else
            log_warning("[BattleUIComponent] SelectSkill failed to show description: popup is nil.")
        end

        log("[BattleUIComponent] SelectSkill key=" .. skillKey .. ", sponsor=" .. self.syncedCurrentActorId)
    end

    method void ClearSkillSelection()
        -- Clears selection data and delegates presentation cleanup to the popup component.
        self.selectedSkillKey = ""
        self.selectedSponsorActorData = nil

        local skillDescriptionPopup = self:GetSkillDescriptionPopup()
        if skillDescriptionPopup ~= nil then
            skillDescriptionPopup:HideSkill()
        end
    end

    method any GetSkillDescriptionPopup()
        -- Resolves the popup component without exposing its presentation internals.
        if isvalid(self.skillDescriptionPopupEntity) == false then
            return nil
        end

        return self.skillDescriptionPopupEntity:GetComponent("script.BattleSkillDescriptionPopup")
    end

end
